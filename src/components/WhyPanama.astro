---
const stats = [
  { value: '0%', label: 'Tax on foreign income' },
  { value: 'USD', label: 'Dollarized economy' },
  { value: 'PR', label: 'Permanent residency on approval' },
  { value: '5 yrs', label: 'Path to citizenship' },
];
---

<section class="section" id="why">
  <div class="wrap">
    <div class="sec-head scroll-reveal">
      <p class="eyebrow">Why Panama</p>
      <h2>A dollarized base with territorial tax.</h2>
      <p class="lede">
        Panama uses the US dollar and taxes only income sourced inside the country. The Qualified Investor Visa is the residency route for people who want that structure on a permanent basis, with citizenship available after five years.
      </p>
    </div>
    <div class="stats">
      {
        stats.map((stat) => (
          <div class="stat">
            <p class="n value">{stat.value}</p>
            <p class="label">{stat.label}</p>
          </div>
        ))
      }
    </div>
    <p class="section-more">
      <a class="cta-link cta-link--ink" href="/panama-qualified-investor-visa-2026">
        See the full visa breakdown
      </a>
    </p>
  </div>
</section>

<style>
  .section {
    background: var(--color-paper);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .lede {
    font-size: 1.05rem;
    color: var(--color-ink-soft);
    max-width: var(--measure);
    margin: var(--space-lede) 0 0;
    line-height: 1.7;
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    margin-top: 3rem;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .stat {
    background: var(--color-paper);
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 1.85rem);
    line-height: 1;
    color: var(--color-ink);
    margin: 0;
  }

  .label {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    font-weight: var(--weight-body);
    color: var(--color-ink-soft);
    margin: 0;
  }

  @media (min-width: 640px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
