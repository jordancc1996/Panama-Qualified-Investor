---
const stats = [
  { value: '0%', label: 'Tax on foreign income' },
  { value: 'USD', label: 'Dollarized economy' },
  { value: 'Top 5', label: 'Most competitive in LatAm' },
  { value: '5 yrs', label: 'Path to citizenship' },
];
---

<section class="section" id="why">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Why Panama</p>
      <h2>A strategic base for <em>global investors.</em></h2>
      <p class="lede">
        Panama sits at the crossroads of the Americas: a dollarized economy, territorial tax system, and one of the fastest-growing financial hubs in Latin America. <a href="/visa">The Qualified Investor Visa</a> is the country's premium residency pathway.
      </p>
    </div>
    <div class="stats">
      {
        stats.map((stat) => (
          <div class="stat">
            <p class="n value">{stat.value}</p>
            <p class="label">{stat.label}</p>
          </div>
        ))
      }
    </div>
    <div class="soft-cta">
      <p>See if you qualify in under 2 minutes.</p>
      <a class="btn btn--navy" href="#book">
        Check Your Eligibility
      </a>
    </div>
    <p class="section-more">
      <a class="cta-link cta-link--ink" href="/visa">
        Explore the visa
      </a>
    </p>
  </div>
</section>

<style>
  .section {
    background: var(--color-paper);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .lede {
    font-size: 1.05rem;
    color: var(--color-ink-soft);
    max-width: var(--measure);
    margin: var(--space-lede) 0 0;
    line-height: 1.7;
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    margin-top: 3rem;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .stat {
    background: var(--color-paper);
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 1.85rem);
    line-height: 1;
    color: var(--color-ink);
    margin: 0;
  }

  .label {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    font-weight: var(--weight-body);
    color: var(--color-ink-soft);
    margin: 0;
  }

  @media (min-width: 640px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .soft-cta {
    margin-top: 2.5rem;
    text-align: left;
  }

  .soft-cta p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    color: var(--color-ink-soft);
    margin: 0;
  }

  .soft-cta .btn {
    margin-top: 1rem;
  }
</style>
