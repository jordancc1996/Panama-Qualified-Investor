---
const audiences = [
  { kicker: 'Americans', href: '/americans' },
  { kicker: 'Canadians', href: '/canadians' },
  { kicker: 'Tech founders', href: '/tech-founders' },
  { kicker: 'H-1B holders', href: '/h1b' },
  { kicker: 'Crypto investors', href: '/crypto-investors' },
];
---

<section class="section bg-cream-tint" id="audiences">
  <div class="wrap">
    <div class="sec-head scroll-reveal">
      <p class="eyebrow">Who this is for</p>
      <h2>Written for five distinct situations.</h2>
      <p class="lede">
        Americans, Canadians, tech founders, H-1B holders, and crypto investors use the same visa for different structural reasons. Tax treatment, timing, and source-of-funds detail live on each dedicated page, not here.
      </p>
    </div>
    <ul class="paths scroll-reveal" data-reveal="stagger">
      {
        audiences.map((item) => (
          <li>
            <a href={item.href}>{item.kicker}</a>
          </li>
        ))
      }
    </ul>
    <p class="section-more">
      <a class="cta-link cta-link--ink" href="/who-is-the-panama-qualified-investor-visa-for">
        Find your path
      </a>
    </p>
  </div>
</section>

<style>
  .section {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .lede {
    color: var(--color-ink-soft);
    margin: var(--space-lede) 0 0;
  }

  .paths {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .paths a {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-ui);
    color: var(--color-navy-900);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.15rem;
    transition: border-color 150ms ease-out, color 150ms ease-out;
  }

  .paths a:hover {
    color: var(--color-navy-950);
    border-bottom-color: var(--color-navy-950);
  }
</style>
