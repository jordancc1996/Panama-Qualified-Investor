---
import { FORMCARRY_ACTION } from '../lib/forms';

const year = new Date().getFullYear();
const program = [
  { href: '/visa', label: 'The Visa' },
  { href: '/benefits', label: 'Benefits' },
  { href: '/process', label: 'Process' },
  { href: '/eligibility', label: 'Eligibility' },
  { href: '/visa', label: 'Investment Options' },
];
const resources = [
  { href: '/faq', label: 'FAQ' },
  { href: '/who-its-for', label: "Who It's For" },
  { href: '/#why', label: 'About Panama' },
  { href: '/#book', label: 'Speak to an Advisor' },
];
const company = [
  { href: '#', label: 'About' },
  { href: '#', label: 'Contact' },
  { href: '#', label: 'Privacy Policy' },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div class="brand-col">
        <a class="brand" href="/">
          <svg class="mark" width="36" height="40" viewBox="0 0 36 40" aria-hidden="true">
            <path
              fill="currentColor"
              d="M18 1.2c4.4 3 9.2 4.5 14.8 4.5v14.2c0 8.8-5.7 16-14.8 19.6C8.9 35.9 3.2 28.7 3.2 19.9V5.7C8.8 5.7 13.6 4.2 18 1.2Z"
            ></path>
            <path
              fill="none"
              stroke="var(--color-navy-950)"
              stroke-width="1.2"
              d="M18 8.2c2.6 1.6 5.4 2.4 8.6 2.4v8.4c0 5-3.2 9.2-8.6 11.3-5.4-2.1-8.6-6.3-8.6-11.3V10.6c3.2 0 6-0.8 8.6-2.4Z"
            ></path>
          </svg>
          <span class="brand-name">Panama Qualified Investor</span>
        </a>
        <p class="tagline">The definitive resource on Panama's Qualified Investor Visa.</p>
        <a class="email" href="mailto:info@panamaqualifiedinvestor.com">info@panamaqualifiedinvestor.com</a>
        <p class="nl-kicker">Monthly updates</p>
        <form class="nl" action={FORMCARRY_ACTION} method="POST" accept-charset="UTF-8">
          <input type="hidden" name="_subject" value="Newsletter signup" />
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
          <label class="sr-only" for="footer-email">Email</label>
          <input id="footer-email" name="email" type="email" autocomplete="email" required placeholder="Enter your email" />
          <button type="submit" aria-label="Subscribe">→</button>
        </form>
        <p class="nl-note">No spam. Unsubscribe anytime.</p>
      </div>

      <div class="col">
        <p class="heading">The Program</p>
        {program.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="col">
        <p class="heading">Resources</p>
        {resources.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="col">
        <p class="heading">Company</p>
        {company.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </div>

    <div class="bottom">
      <p>© {year} Panama Qualified Investor. All rights reserved.</p>
      <a href="#">Privacy Policy</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(200deg, #4e6478 0%, #405363 55%, #2d3d4d 100%);
    color: var(--color-on-navy-dim);
    padding: 5rem 0 2rem;
  }

  .top {
    display: grid;
    gap: 2.5rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .mark {
    width: 36px;
    height: 40px;
    color: var(--color-cream);
    display: block;
  }

  .brand-name {
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-cream);
    padding-top: 0.35rem;
    border-top: 1px solid var(--color-line-dark);
    margin-top: 0.35rem;
    line-height: var(--leading-ui);
  }

  .tagline {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    font-weight: var(--weight-body);
    color: var(--color-on-navy-dim);
    margin: 1rem 0 0;
    max-width: 22rem;
  }

  .email {
    display: inline-block;
    color: #fff;
    margin-top: 1.5rem;
    font-size: var(--text-small);
  }

  .nl-kicker {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    margin: 1.5rem 0 0.6rem;
  }

  .nl {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  .nl input {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
    font-size: 0.88rem;
    color: var(--color-on-navy);
    width: 100%;
    max-width: 14rem;
    outline: none;
  }

  .nl input::placeholder {
    color: var(--color-muted);
  }

  .nl input:focus {
    border-color: #fff;
    box-shadow: none;
  }

  .nl button {
    background: #fff;
    color: #405363;
    border-radius: 4px;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    font-size: 0.82rem;
    cursor: pointer;
    border: none;
    flex-shrink: 0;
  }

  .nl button:hover {
    background: #f7f7f7;
  }

  .nl-note {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: rgba(255, 255, 255, 0.72);
    letter-spacing: 0.06em;
    margin: 0.5rem 0 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .heading {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 1.5rem;
  }

  .col a {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-on-navy-dim);
    padding-block: 0.35rem;
    transition: color 150ms ease-out;
  }

  .col a:hover {
    color: var(--color-on-navy);
  }

  .bottom {
    border-top: 1px solid var(--color-line-dark);
    margin-top: 3rem;
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .bottom p,
  .bottom a {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    letter-spacing: 0.06em;
    margin: 0;
    text-transform: uppercase;
  }

  .bottom a {
    color: var(--color-on-navy-dim);
    transition: color 150ms ease-out;
  }

  .bottom a:hover {
    color: var(--color-on-navy);
  }

  @media (min-width: 1024px) {
    .top {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
