---
import Logo from './Logo.astro';
import PreferredSourcesCTA from './PreferredSourcesCTA.astro';

const year = new Date().getFullYear();
const program = [
  { href: '/panama-qualified-investor-visa-2026', label: 'The Visa' },
  { href: '/panama-qualified-investor-visa-benefits', label: 'Benefits' },
  { href: '/panama-qualified-investor-visa-process-2026', label: 'Process' },
  { href: '/panama-qualified-investor-visa-eligibility', label: 'Eligibility' },
  { href: '/panama-qualified-investor-visa-cost', label: 'Cost' },
  { href: '/panama-qualified-investor-visa-2026#investment-routes', label: 'Investment Options' },
];
const resources = [
  { href: '/panama-qualified-investor-visa-faq', label: 'FAQ' },
  { href: '/who-is-the-panama-qualified-investor-visa-for', label: "Who It's For" },
  { href: '/#why', label: 'About Panama' },
  { href: '/#book', label: 'Speak to an Advisor' },
];
const company = [
  { href: '/about', label: 'About' },
  { href: '/#book', label: 'Contact', advisor: true },
  { href: '/privacy', label: 'Privacy Policy' },
];
---

<PreferredSourcesCTA />
<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div class="brand-col">
        <a class="brand" href="/">
          <Logo variant="on-dark" />
        </a>
        <p class="tagline">The definitive resource on Panama's Qualified Investor Visa.</p>
        <a class="email" href="mailto:info@panamaqualifiedinvestor.com">info@panamaqualifiedinvestor.com</a>
      </div>

      <div class="col">
        <p class="heading">The Program</p>
        {program.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="col">
        <p class="heading">Resources</p>
        {resources.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="col">
        <p class="heading">Company</p>
        {
          company.map((item) =>
            item.advisor ? (
              <a href={item.href} data-advisor-open>
                {item.label}
              </a>
            ) : (
              <a href={item.href}>{item.label}</a>
            )
          )
        }
      </div>
    </div>

    <div class="bottom">
      <p>© {year} Panama Qualified Investor. All rights reserved.</p>
      <a href="/privacy">Privacy Policy</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(200deg, #4e6478 0%, #405363 55%, #2d3d4d 100%);
    color: var(--color-on-navy-dim);
    padding: 5rem 0 2rem;
  }

  .top {
    display: grid;
    gap: 2.5rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .brand :global(.site-logo) {
    height: 48px;
    max-width: min(260px, 100%);
  }

  .tagline {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    font-weight: var(--weight-body);
    color: var(--color-on-navy-dim);
    margin: 1rem 0 0;
    max-width: 22rem;
  }

  .email {
    display: inline-block;
    color: #fff;
    margin-top: 1.5rem;
    font-size: var(--text-small);
  }

  .col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .heading {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 1.5rem;
  }

  .col a,
  .placeholder {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-on-navy-dim);
    padding-block: 0.35rem;
    transition: color 150ms ease-out;
  }

  .placeholder {
    cursor: default;
  }

  .col a:hover {
    color: var(--color-on-navy);
  }

  .bottom {
    border-top: 1px solid var(--color-line-dark);
    margin-top: 3rem;
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .bottom p,
  .bottom a {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    letter-spacing: 0.06em;
    margin: 0;
    text-transform: uppercase;
  }

  .bottom a {
    color: var(--color-on-navy-dim);
    transition: color 150ms ease-out;
  }

  .bottom a:hover {
    color: var(--color-on-navy);
  }

  @media (min-width: 1024px) {
    .top {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
