---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const siteName = 'Panama Qualified Investor';
---

<section class="preferred-sources" aria-labelledby="preferred-sources-heading">
  <div class="wrap">
    <div class="inner">
      <p class="kicker">Google Search</p>
      <h2 id="preferred-sources-heading">Follow {siteName} on Google</h2>
      <p class="sub">
        Add {siteName} as a preferred source to see more of our research, guides, and analysis in Google Search.
      </p>
      <div class="btn-slot">
        <div google-add-preferred-source-btn data-lang="en" data-theme={theme}></div>
      </div>
    </div>
  </div>
</section>

<style>
  .preferred-sources {
    padding: 2.5rem 0 3rem;
    background: transparent;
  }

  .inner {
    max-width: 38rem;
    margin-inline: auto;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy-900);
    margin: 0 0 0.5rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.8vw, 1.65rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 0 0 0.85rem;
    letter-spacing: 0;
  }

  .sub {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: var(--weight-body);
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
  }

  .btn-slot {
    margin-top: 1.25rem;
    min-height: 40px;
  }

  .btn-slot :global([google-add-preferred-source-btn]) {
    display: inline-block;
    max-width: 100%;
  }
</style>
