---
import { FORMCARRY_ACTION } from '../lib/forms';
import LinkedInField from './LinkedInField.astro';

const bg = '/images/Panama-Qualified-Investor-Visa8.webp';

const stats = [
  { n: '30–90 days', t: 'From document submission to provisional permit' },
  { n: '$300k', t: 'Current real estate minimum; scheduled to increase to $500,000 on October 15, 2026' },
  { n: '0%', t: "Tax on foreign-sourced income under Panama's territorial system" },
];

const expect = [
  'Review of your goals and financial situation',
  'Which investment route fits your profile',
  'Timeline and document requirements',
  'Honest assessment of whether the QIV is right for you',
];
---

<section class="cta" id="book">
  <img class="bg" src={bg} alt="Panama City skyline beyond a neighborhood of low-rise rooftops and trees" width="1920" height="800" loading="lazy" />
  <div class="wrap content">
    <div class="form-col">
      <h2>Arrange your <em>advisory meeting</em></h2>
      <p class="sub">
        15 minutes with an advisor who specializes in your situation. No obligation, no pressure, just clarity on whether the QIV is right for you.
      </p>
      <form class="form" id="book-form" action={FORMCARRY_ACTION} method="POST" accept-charset="UTF-8">
        <input type="hidden" name="_subject" value="Private advisory meeting request" />
        <input type="hidden" name="source" value="homepage_book_form" />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <label class="sr-only" for="book_first_name">First name</label>
        <input id="book_first_name" name="first_name" type="text" required placeholder="Enter your first name" />
        <label class="sr-only" for="book_last_name">Last name</label>
        <input id="book_last_name" name="last_name" type="text" required placeholder="Enter your last name" />
        <label class="sr-only" for="book-email">Email</label>
        <input id="book-email" name="email" type="email" autocomplete="email" required placeholder="Enter your email" />
        <label class="sr-only" for="book-phone">Phone / WhatsApp</label>
        <input id="book-phone" name="phone" type="tel" autocomplete="tel" placeholder="Enter your phone number" />
        <LinkedInField id="book-linkedin" labeled={false} />
        <label class="sr-only" for="situation">I am a...</label>
        <select id="situation" name="situation" required>
          <option value="" disabled selected>Select your situation</option>
          <option value="american">American exploring a Plan B</option>
          <option value="canadian">Canadian investor</option>
          <option value="tech-founder">Tech founder / remote CEO</option>
          <option value="h1b">H-1B visa holder</option>
          <option value="other">Other / not listed</option>
        </select>
        <label class="sr-only" for="timeline">Investment timeline</label>
        <select id="timeline" name="timeline" required>
          <option value="" disabled selected>When are you looking to invest?</option>
          <option value="immediate">Within the next 3 months</option>
          <option value="6months">Within 6 months</option>
          <option value="year">Within a year</option>
          <option value="exploring">Just exploring for now</option>
        </select>
        <button class="btn btn--gold" type="submit">
          Speak with an Advisor
        </button>
      </form>
      <p class="fine">Your information is confidential. We respond within one business day.</p>
    </div>
    <div class="trust-col">
      <div class="stats">
        {
          stats.map((stat) => (
            <div class="stat">
              <p class="n">{stat.n}</p>
              <p>{stat.t}</p>
            </div>
          ))
        }
      </div>
      <div class="expect">
        <p class="expect-kicker">What to expect on the call:</p>
        <ul>
          {
            expect.map((item) => (
              <li>
                <span>✓</span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="alt">
        <p>Prefer to reach out directly?</p>
        <div class="alt-btns">
          <a class="btn btn--outline-cream btn--sm" href="https://wa.me/" target="_blank" rel="noreferrer">
            WhatsApp Us
          </a>
          <a class="btn btn--outline-cream btn--sm" href="mailto:info@panamaqualifiedinvestor.com">
            Email Us
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="continue-cue" aria-hidden="true">
    <span class="continue-cue-text">Continue</span>
    <svg width="12" height="8" viewBox="0 0 12 8" fill="none">
      <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1" stroke-linecap="round"></path>
    </svg>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: visible;
    isolation: isolate;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(45, 61, 77, 0.94) 30%,
      rgba(45, 61, 77, 0.65) 60%,
      rgba(45, 61, 77, 0.45)
    );
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .form-col {
    max-width: 28rem;
    text-align: left;
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 600;
    color: var(--color-on-navy);
    margin: 0;
    text-align: left;
  }

  h2 em {
    font-style: italic;
  }

  .sub {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    color: var(--color-on-navy-dim);
    line-height: var(--leading-body);
    margin: 0.75rem 0 0;
    text-align: left;
  }

  .form {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .form input,
  .form select {
    width: 100%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
    color: var(--color-on-navy);
    font-family: var(--font-sans);
    font-size: var(--text-input);
    outline: none;
  }

  /* Inputs sit on a dark photo; --color-muted (#5c5e62) is for light surfaces
     and disappears here. Match the select’s on-navy white and add a slightly
     more opaque fill so type stays readable over any part of the image. */
  .form input {
    background: rgba(255, 255, 255, 0.16);
    color: var(--color-on-navy);
  }

  .form input::placeholder {
    color: var(--color-on-navy);
    opacity: 1;
  }

  .form input:focus,
  .form select:focus,
  .form :global(.linkedin-field input:focus) {
    border-color: var(--color-navy-900);
    box-shadow: none;
  }

  .form :global(.linkedin-field input) {
    width: 100%;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
    color: var(--color-on-navy);
    font-family: var(--font-sans);
    font-size: var(--text-input);
    outline: none;
  }

  .form :global(.linkedin-field input::placeholder) {
    color: var(--color-on-navy);
    opacity: 1;
  }

  .form :global(.linkedin-field input[aria-invalid='true']) {
    border-color: #c0392b;
  }

  .form :global(.linkedin-field .err) {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    line-height: 1.4;
    color: #c0392b;
    margin: 0.35rem 0 0;
  }

  .form input:focus {
    color: var(--color-on-navy);
  }

  .form input:focus::placeholder {
    color: var(--color-on-navy);
    opacity: 1;
  }

  .form select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, #fff 50%),
      linear-gradient(135deg, #fff 50%, transparent 50%);
    background-position:
      calc(100% - 22px) 50%,
      calc(100% - 17px) 50%;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
  }

  .form select option {
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .form .btn {
    width: 100%;
    margin-top: 0.5rem;
  }

  .fine {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: rgba(255, 255, 255, 0.72);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 1rem 0 0;
  }

  .trust-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    justify-content: center;
  }

  .stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-lede);
  }

  .stat {
    display: flex;
    align-items: flex-start;
    gap: var(--space-eyebrow);
    padding-block: var(--space-lede);
    border-top: 1px solid var(--color-line-dark);
  }

  .stat:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .n {
    font-family: var(--font-display);
    font-size: var(--text-stat);
    font-weight: 500;
    color: #ffffff;
    line-height: var(--leading-tight);
    min-width: 4rem;
    margin: 0;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .stat p:last-child {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-on-navy-dim);
    line-height: var(--leading-body);
    margin: 0;
  }

  .expect {
    background: var(--color-navy-800);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 1.5rem;
  }

  .expect-kicker {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 0.75rem;
  }

  .expect ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .expect li {
    display: flex;
    align-items: flex-start;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--color-on-navy-dim);
  }

  .expect span {
    color: rgba(255, 255, 255, 0.7);
    margin-right: 0.5rem;
    flex-shrink: 0;
  }

  .alt p {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-on-navy-dim);
    margin: 0 0 0.75rem;
  }

  .alt-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .alt-btns .btn {
    padding: 0.75rem 1.4rem;
    font-size: var(--text-ui);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 1024px) {
    .content {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .trust-col {
      padding-left: 3rem;
    }
  }
</style>

<script>
  import { linkedinFieldError, normalizeLinkedInUrl } from '../lib/linkedin';

  const form = document.getElementById('book-form') as HTMLFormElement | null;
  const input = document.getElementById('book-linkedin') as HTMLInputElement | null;
  const err = document.getElementById('book-linkedin-error');

  const setLinkedInError = (message: string) => {
    if (!input || !err) return;
    const invalid = Boolean(message);
    input.setAttribute('aria-invalid', String(invalid));
    if (invalid) {
      err.hidden = false;
      err.textContent = message;
      input.setAttribute('aria-describedby', err.id);
    } else {
      err.hidden = true;
      err.textContent = '';
      input.removeAttribute('aria-describedby');
    }
  };

  if (form && input) {
    input.addEventListener('input', () => {
      if (input.getAttribute('aria-invalid') === 'true') {
        setLinkedInError(linkedinFieldError(input.value));
      }
    });
    input.addEventListener('blur', () => setLinkedInError(linkedinFieldError(input.value)));
    form.addEventListener('submit', (event) => {
      const message = linkedinFieldError(input.value);
      setLinkedInError(message);
      if (message) {
        event.preventDefault();
        input.focus();
        return;
      }
      const normalized = normalizeLinkedInUrl(input.value);
      if (normalized.ok) input.value = normalized.value;
    });
  }
</script>
