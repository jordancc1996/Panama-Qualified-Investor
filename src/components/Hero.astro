---
const heroImage =
  'https://images.unsplash.com/photo-1632505702897-cc41b0ba3b64?w=1920&q=80&auto=format&fit=crop';
---

<section class="hero" id="top">
  <img
    class="hero-bg"
    src={heroImage}
    alt="Panama City skyline across the bay"
    width="1920"
    height="1080"
    loading="eager"
  />
  <div class="content">
    <p class="eyebrow eyebrow--on-navy rv">Panama Qualified Investor</p>
    <h1 class="rv" style="--rv-delay: 0.1s">
      The complete guide to Panama's <em>Qualified Investor Visa.</em>
    </h1>
    <p class="subtext rv" style="--rv-delay: 0.2s">
      Everything Americans, Canadians, tech founders, and H-1B holders need to know about obtaining permanent residency in Panama through a $300,000 investment — tax implications, timelines, eligibility, and what life actually looks like on the ground.
    </p>
    <div class="actions rv" style="--rv-delay: 0.3s">
      <a class="btn btn--gold" href="#book">
        Book a Free Assessment <span class="arr">→</span>
      </a>
      <a class="btn btn--outline-cream" href="#program">
        Read the Full Guide <span class="arr">↓</span>
      </a>
      <a class="text-link" href="#audiences">Who Is This For?</a>
    </div>
    <div class="gold-rule rv" style="--rv-delay: 0.35s"></div>
    <p class="trust rv" style="--rv-delay: 0.4s">
      Updated for 2026 · sourced from Panama's Servicio Nacional de Migración and practicing immigration attorneys.
    </p>
    <div class="proof rv" style="--rv-delay: 0.45s">
      <p><span>✓</span> 30–60 day processing</p>
      <p><span>✓</span> No language requirement</p>
      <p><span>✓</span> $300,000 minimum investment</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - var(--header-h));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: var(--header-h);
    isolation: isolate;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(45, 61, 77, 0.96) 16%,
      rgba(45, 61, 77, 0.72) 50%,
      rgba(45, 61, 77, 0.38)
    );
    pointer-events: none;
  }

  .content {
    text-align: center;
    max-width: var(--measure);
    width: 100%;
    margin-inline: auto;
    padding: 4rem clamp(1.35rem, 5vw, 3rem);
    box-sizing: border-box;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: var(--weight-bold);
    color: var(--color-on-navy);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-heading);
    margin: 1.1rem 0 0;
    overflow-wrap: break-word;
  }

  h1 em {
    font-style: italic;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.80);
  }

  .subtext {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    font-weight: var(--weight-body);
    color: var(--color-on-navy-dim);
    max-width: var(--measure);
    margin: 1.5rem auto 0;
  }

  .actions {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .gold-rule {
    max-width: 600px;
    width: 100%;
    margin: 3rem auto 0;
  }

  .trust {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: var(--weight-ui);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    max-width: 52ch;
    margin: 2.5rem auto 0;
    text-align: center;
    line-height: 1.6;
  }

  .text-link {
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    font-weight: var(--weight-ui);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.86);
  }

  .text-link:hover {
    text-decoration: underline;
  }

  .proof {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .proof p {
    display: flex;
    align-items: center;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: var(--weight-ui);
    letter-spacing: var(--tracking-ui);
    color: var(--color-on-navy-dim);
  }

  .proof span {
    color: rgba(255, 255, 255, 0.7);
    margin-right: 0.4rem;
  }

  @media (min-width: 768px) {
    .proof {
      flex-direction: row;
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .actions {
      flex-direction: row;
    }
  }
</style>
