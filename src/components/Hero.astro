---
import InvestmentDeadlineNote from './InvestmentDeadlineNote.astro';

const heroImage = '/images/hero-papers.webp';
---

<section class="hero" id="top">
  <img
    class="hero-bg"
    src={heroImage}
    alt="The F&F Tower in Panama City, a teal glass spiral skyscraper against a clear sky"
    width="682"
    height="1024"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="content">
    <h1>Permanent residency in Panama from $300,000.</h1>
    <p class="subtext">
      The Panama Qualified Investor Visa grants indefinite residency through titled real estate, listed securities, or a bank deposit. The current real estate minimum is $300,000; this is scheduled to increase to $500,000 on October 15, 2026.
      <a href="/panama-qualified-investor-visa-2026">See the full visa breakdown</a>.
    </p>
    <InvestmentDeadlineNote variant="on-navy" />
    <button
      class="hero-cta"
      type="button"
      data-advisor-contact-open
      aria-haspopup="dialog"
      aria-controls="advisor-contact-modal"
    >
      Speak with an Advisor<span>→</span>
    </button>
    <div class="scroll-hint" aria-hidden="true">
      <svg width="20" height="12" viewBox="0 0 20 12" fill="none">
        <path d="M1 1L10 10L19 1" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - var(--header-h));
    overflow: visible;
    margin-top: var(--header-h);
    isolation: isolate;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top right,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.5) 35%,
      rgba(0, 0, 0, 0.1) 100%
    );
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    text-align: left;
    min-height: calc(100dvh - var(--header-h));
    width: 100%;
    max-width: var(--wrap-max);
    margin-inline: auto;
    padding-inline: clamp(1.35rem, 4vw, 3rem);
    padding-bottom: clamp(5rem, 10vw, 8rem);
    box-sizing: border-box;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #fff;
    max-width: 780px;
    text-wrap: balance;
    margin: 0;
  }

  .subtext {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-body);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.6);
    max-width: 540px;
    margin: 0.9rem 0 0;
  }

  .subtext a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    transition: color 150ms ease-out;
  }

  .subtext a:hover {
    color: #f5f0eb;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    appearance: none;
    background: #f5f0eb;
    color: #1a1a1a;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.75rem 1.5rem;
    min-height: 48px;
    border-radius: var(--radius);
    border: none;
    cursor: pointer;
    margin-top: 1.75rem;
    transition: background-color 150ms ease-out;
  }

  .hero-cta span {
    margin-left: 0.25rem;
  }

  .hero-cta:hover {
    background: #fff;
    color: #1a1a1a;
  }

  @media (max-width: 767px) {
    .content {
      padding-bottom: 3rem;
    }

    .subtext {
      max-width: 100%;
    }
  }

</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const hint = document.querySelector('.scroll-hint');
    const hero = document.querySelector('.hero');
    if (hint && hero) {
      const obs = new IntersectionObserver(([e]) => {
        hint.style.opacity = e.isIntersecting ? '1' : '0';
        hint.style.transition = 'opacity 0.3s';
      }, { threshold: 0.5 });
      obs.observe(hero);
    }
  });
</script>
