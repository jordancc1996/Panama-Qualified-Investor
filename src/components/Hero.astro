---
const heroImage =
  'https://images.unsplash.com/photo-1632505702897-cc41b0ba3b64?w=1920&q=80&auto=format&fit=crop';
---

<section class="hero" id="top">
  <img
    class="hero-bg"
    src={heroImage}
    alt="Panama City skyline across the bay"
    width="1920"
    height="1080"
    loading="eager"
  />
  <div class="content">
    <h1>The complete guide to Panama's Qualified Investor Visa.</h1>
    <p class="subtext">
      Everything Americans, Canadians, tech founders, and H-1B holders need to know about obtaining permanent residency in Panama through a $300,000 investment: tax implications, timelines, eligibility, and what life actually looks like on the ground.
    </p>
    <a class="hero-cta" href="/#book">
      Speak with an Advisor<span>→</span>
    </a>
  </div>
  <div class="scroll-hint" aria-hidden="true">
    <svg width="20" height="12" viewBox="0 0 20 12" fill="none">
      <path d="M1 1L10 10L19 1" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - var(--header-h));
    overflow: hidden;
    margin-top: var(--header-h);
    isolation: isolate;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top right,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.5) 35%,
      rgba(0, 0, 0, 0.1) 100%
    );
    pointer-events: none;
  }

  .content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    text-align: left;
    min-height: calc(100dvh - var(--header-h));
    width: 100%;
    max-width: var(--wrap-max);
    margin: 0;
    padding-inline: clamp(1.35rem, 4vw, 3rem);
    padding-bottom: clamp(5rem, 10vw, 8rem);
    box-sizing: border-box;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #fff;
    max-width: 780px;
    text-wrap: balance;
    margin: 0;
  }

  .subtext {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.82rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.6);
    max-width: 480px;
    margin: 0.9rem 0 0;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #f5f0eb;
    color: #1a1a1a;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    margin-top: 1.75rem;
    transition: background-color 150ms ease-out;
  }

  .hero-cta span {
    margin-left: 0.25rem;
  }

  .hero-cta:hover {
    background: #fff;
    color: #1a1a1a;
  }

  @media (max-width: 767px) {
    .content {
      padding-bottom: 3rem;
    }

    .subtext {
      max-width: 100%;
    }
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    animation: softBounce 2.5s ease-in-out infinite;
    pointer-events: none;
    z-index: 2;
  }

  @keyframes softBounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      animation: none;
    }
  }
</style>

<script>
  const hint = document.querySelector('.scroll-hint');
  const hero = document.querySelector('.hero');
  if (hint instanceof HTMLElement && hero) {
    const obs = new IntersectionObserver(
      ([e]) => {
        hint.style.opacity = e.isIntersecting ? '1' : '0';
        hint.style.transition = 'opacity 0.3s';
      },
      { threshold: 0.5 }
    );
    obs.observe(hero);
  }
</script>
