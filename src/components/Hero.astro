---
import InvestmentDeadlineNote from './InvestmentDeadlineNote.astro';

const heroImage = '/images/hero-papers.webp';
---

<section class="hero" id="top">
  <img
    class="hero-bg"
    src={heroImage}
    alt="The F&F Tower in Panama City, a teal glass spiral skyscraper against a clear sky"
    width="682"
    height="1024"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="panel">
    <h1>Permanent residency in Panama from $300,000.</h1>
    <p class="subtext">
      The Panama Qualified Investor Visa grants indefinite residency through titled real estate, listed securities, or a bank deposit.{' '}
      <a href="/panama-qualified-investor-visa-2026">See the full visa breakdown</a>.
    </p>
    <InvestmentDeadlineNote variant="plain-on-dark" />
    <button
      class="hero-cta"
      type="button"
      data-advisor-contact-open
      aria-haspopup="dialog"
      aria-controls="advisor-contact-modal"
    >
      Speak with an Advisor<span>→</span>
    </button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: var(--header-h);
    isolation: isolate;
    scroll-margin-top: calc(var(--header-h) + 1rem);
    overflow: hidden;
  }

  .hero-bg {
    display: block;
    width: 100%;
    height: 45vh;
    object-fit: cover;
    object-position: center 35%;
    flex-shrink: 0;
  }

  .panel {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    text-align: left;
    background: #405363;
    width: 100%;
    flex: 1 1 auto;
    padding-inline: clamp(1.35rem, 4vw, 3rem);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    box-sizing: border-box;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: normal;
    font-size: var(--text-h1-hero);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-heading);
    color: #fff;
    max-width: 780px;
    text-wrap: balance;
    margin: 0;
  }

  .subtext {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-lede);
    line-height: var(--leading-lede);
    color: rgba(255, 255, 255, 0.85);
    max-width: var(--measure);
    margin: 0.9rem 0 0;
  }

  /* Beat global main p a link color on the slate panel */
  .panel .subtext a,
  :global(main) .panel .subtext a {
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: color 150ms ease-out, opacity 150ms ease-out;
  }

  .subtext a:visited {
    color: #fff;
  }

  .panel .subtext a:hover,
  :global(main) .panel .subtext a:hover {
    color: #fff;
    opacity: 0.85;
  }

  .panel .subtext a:visited,
  :global(main) .panel .subtext a:visited {
    color: #fff;
  }

  /* On-dark CTA (hero-local; do not depend on PR #18) */
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    appearance: none;
    background: transparent;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 14px 28px;
    border-radius: 2px;
    border: 1px solid #fff;
    cursor: pointer;
    margin-top: 1.75rem;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out,
      border-color 150ms ease-out;
  }

  .hero-cta span {
    margin-left: 0.25rem;
  }

  .hero-cta:hover {
    background: #fff;
    color: #405363;
    border-color: #fff;
  }

  @media (max-width: 767px) {
    .subtext {
      max-width: 100%;
    }
  }

  /* Desktop: photo as full-bleed background; solid slate panel left */
  @media (min-width: 1024px) {
    .hero {
      flex-direction: row;
      min-height: calc(100dvh - var(--header-h));
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
    }

    .panel {
      width: 42%;
      max-width: 42%;
      min-height: calc(100dvh - var(--header-h));
      padding-bottom: clamp(5rem, 10vw, 8rem);
      padding-top: clamp(3rem, 6vw, 5rem);
    }
  }
</style>
