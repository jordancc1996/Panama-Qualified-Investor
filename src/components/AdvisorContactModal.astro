---
import { FORMCARRY_ACTION } from '../lib/forms';
---

<div class="shell" id="advisor-contact-shell" aria-hidden="true" inert>
  <div class="backdrop" data-advisor-contact-dismiss></div>
  <div
    class="panel"
    id="advisor-contact-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="advisor-contact-title"
    aria-describedby="advisor-contact-lede"
  >
    <button class="x" type="button" data-advisor-contact-dismiss aria-label="Close">✕</button>
    <div class="intro">
      <h2 id="advisor-contact-title">Speak with an Advisor</h2>
      <p class="lede" id="advisor-contact-lede">
        Tell us about your situation. An advisor will follow up to discuss whether the Qualified Investor Visa is a fit.
      </p>
    </div>

    <form class="form" id="advisor-contact-form" action={FORMCARRY_ACTION} method="POST" accept-charset="UTF-8" novalidate>
      <input type="hidden" name="_subject" value="Private advisory meeting request" />
      <input type="hidden" name="source" value="advisor_contact_modal" />
      <input type="text" name="_gotcha" class="gotcha" tabindex="-1" autocomplete="off" />

      <div class="row">
        <div class="field">
          <label for="advisor-contact-first-name">
            Name<span class="req">*</span>
          </label>
          <input id="advisor-contact-first-name" name="first_name" type="text" autocomplete="given-name" required />
          <p class="err" id="advisor-contact-first-name-error" hidden></p>
        </div>
        <div class="field">
          <label for="advisor-contact-last-name">
            Last name<span class="req">*</span>
          </label>
          <input id="advisor-contact-last-name" name="last_name" type="text" autocomplete="family-name" required />
          <p class="err" id="advisor-contact-last-name-error" hidden></p>
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="advisor-contact-email">
            Email<span class="req">*</span>
          </label>
          <input id="advisor-contact-email" name="email" type="email" autocomplete="email" required />
          <p class="err" id="advisor-contact-email-error" hidden></p>
        </div>
        <div class="field">
          <label for="advisor-contact-phone">Phone number</label>
          <input
            id="advisor-contact-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            placeholder="+1 201-555-0123"
          />
          <p class="err" id="advisor-contact-phone-error" hidden></p>
        </div>
      </div>

      <div class="field">
        <label for="advisor-contact-message">Message</label>
        <textarea
          id="advisor-contact-message"
          name="message"
          rows="4"
          placeholder="Are you looking at a particular investment route, such as real estate, securities, or a bank deposit, or would you like an introductory call?"
        ></textarea>
        <p class="err" id="advisor-contact-message-error" hidden></p>
      </div>

      <div class="consent">
        <input id="advisor-contact-privacy" name="privacy_agreed" type="checkbox" value="yes" required />
        <label for="advisor-contact-privacy">
          I agree to the <a href="/privacy">privacy policy</a>.
        </label>
      </div>
      <p class="err" id="advisor-contact-privacy-error" hidden></p>

      <p class="form-err" id="advisor-contact-form-error" hidden></p>
      <button class="submit" type="submit" id="advisor-contact-submit">
        <span>Submit</span>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path
            d="M3 11L11 3M11 3H5.5M11 3V8.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </form>

    <p class="thanks" id="advisor-contact-thanks" hidden tabindex="-1">
      Thanks. Someone from our team will reach out shortly.
    </p>
  </div>
</div>

<style>
  .shell {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .shell.is-open {
    display: flex;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    background: rgba(45, 61, 77, 0.72);
  }

  .panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 38rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 1.75rem 1.5rem 1.5rem;
  }

  .x {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.35rem;
  }

  .intro {
    display: grid;
    gap: var(--space-lede);
    margin: 0 2rem 1.35rem 0;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.8vw, 1.65rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: 0;
  }

  .lede {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  .gotcha {
    display: none;
  }

  .field label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.3rem;
  }

  .req {
    color: #c0392b;
    margin-left: 0.15rem;
  }

  .field input,
  .field textarea {
    width: 100%;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--color-ink);
    outline: none;
  }

  .field textarea {
    min-height: 7.5rem;
    resize: vertical;
    line-height: var(--leading-body);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-muted);
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--color-navy-900);
    box-shadow: none;
  }

  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: #c0392b;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .consent input {
    margin-top: 0.2rem;
    flex-shrink: 0;
    accent-color: var(--color-navy-900);
  }

  .consent label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .consent a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .err,
  .form-err {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.4;
    color: #c0392b;
    margin: 0.35rem 0 0;
  }

  .submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.35rem;
    background: var(--color-navy-900);
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
  }

  .submit:hover:not(:disabled) {
    background: var(--color-navy-800);
  }

  .submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .thanks {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-ink);
    margin: 0.5rem 0 0;
  }

  @media (min-width: 640px) {
    .intro {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      align-items: start;
      gap: 1.25rem;
    }

    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  const FOCUSABLE =
    'a[href], button:not([disabled]), input:not([disabled]):not([tabindex="-1"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  const shell = document.getElementById('advisor-contact-shell');
  const panel = document.getElementById('advisor-contact-modal');
  const form = document.getElementById('advisor-contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('advisor-contact-submit') as HTMLButtonElement | null;
  const thanks = document.getElementById('advisor-contact-thanks');
  const formError = document.getElementById('advisor-contact-form-error');
  const privacy = document.getElementById('advisor-contact-privacy') as HTMLInputElement | null;
  const privacyErr = document.getElementById('advisor-contact-privacy-error');

  if (shell instanceof HTMLElement && panel instanceof HTMLElement && form && submitBtn && thanks && privacy) {
    let lastFocus: HTMLElement | null = null;

    type FieldEl = HTMLInputElement | HTMLTextAreaElement;

    const fields: { el: FieldEl; err: HTMLElement | null; check: (el: FieldEl) => string }[] = [
      {
        el: document.getElementById('advisor-contact-first-name') as HTMLInputElement,
        err: document.getElementById('advisor-contact-first-name-error'),
        check: (el) => (el.value.trim() ? '' : 'Enter your name.'),
      },
      {
        el: document.getElementById('advisor-contact-last-name') as HTMLInputElement,
        err: document.getElementById('advisor-contact-last-name-error'),
        check: (el) => (el.value.trim() ? '' : 'Enter your last name.'),
      },
      {
        el: document.getElementById('advisor-contact-email') as HTMLInputElement,
        err: document.getElementById('advisor-contact-email-error'),
        check: (el) => {
          if (!el.value.trim()) return 'Enter your email address.';
          if (!el.checkValidity()) return 'Enter a valid email address.';
          return '';
        },
      },
    ];

    const setError = (el: HTMLElement, err: HTMLElement | null, message: string) => {
      if (!err) return;
      const invalid = Boolean(message);
      el.setAttribute('aria-invalid', String(invalid));
      if (invalid) {
        err.hidden = false;
        err.textContent = message;
        el.setAttribute('aria-describedby', err.id);
      } else {
        err.hidden = true;
        err.textContent = '';
        el.removeAttribute('aria-describedby');
      }
    };

    const setPrivacyError = (message: string) => {
      if (!privacyErr) return;
      const invalid = Boolean(message);
      privacy.setAttribute('aria-invalid', String(invalid));
      privacyErr.hidden = !invalid;
      privacyErr.textContent = message;
    };

    const focusables = () =>
      [...panel.querySelectorAll<HTMLElement>(FOCUSABLE)].filter((el) => {
        if (el.hasAttribute('disabled') || el.tabIndex === -1) return false;
        if (el.closest('[hidden]')) return false;
        return true;
      });

    const open = (trigger: HTMLElement) => {
      lastFocus = trigger;
      form.hidden = false;
      thanks.hidden = true;
      if (formError) {
        formError.hidden = true;
        formError.textContent = '';
      }
      submitBtn.disabled = false;
      submitBtn.querySelector('span')!.textContent = 'Submit';
      shell.classList.add('is-open');
      shell.removeAttribute('aria-hidden');
      shell.inert = false;
      document.body.style.overflow = 'hidden';
      document.getElementById('advisor-contact-first-name')?.focus();
    };

    const close = () => {
      shell.classList.remove('is-open');
      shell.setAttribute('aria-hidden', 'true');
      shell.inert = true;
      document.body.style.overflow = '';
      lastFocus?.focus();
    };

    const onKey = (event: KeyboardEvent) => {
      if (!shell.classList.contains('is-open')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      if (event.key !== 'Tab') return;
      const nodes = focusables();
      if (nodes.length === 0) return;
      const first = nodes[0];
      const last = nodes[nodes.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    document.querySelectorAll<HTMLElement>('[data-advisor-contact-open]').forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.preventDefault();
        open(btn);
      });
    });

    shell.querySelectorAll('[data-advisor-contact-dismiss]').forEach((el) => {
      el.addEventListener('click', () => close());
    });

    document.addEventListener('keydown', onKey);

    fields.forEach(({ el, err, check }) => {
      if (!el || !err) return;
      el.addEventListener('blur', () => setError(el, err, check(el)));
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true') setError(el, err, check(el));
      });
    });

    privacy.addEventListener('change', () => {
      if (privacy.getAttribute('aria-invalid') === 'true') {
        setPrivacyError(privacy.checked ? '' : 'Confirm that you agree to the privacy policy.');
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      let firstInvalid: HTMLElement | null = null;
      fields.forEach(({ el, err, check }) => {
        if (!el) return;
        const message = check(el);
        setError(el, err, message);
        if (message && !firstInvalid) firstInvalid = el;
      });
      const privacyMessage = privacy.checked ? '' : 'Confirm that you agree to the privacy policy.';
      setPrivacyError(privacyMessage);
      if (privacyMessage && !firstInvalid) firstInvalid = privacy;
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.querySelector('span')!.textContent = 'Sending';
      if (formError) {
        formError.hidden = true;
        formError.textContent = '';
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error('submit-failed');
        form.hidden = true;
        thanks.hidden = false;
        thanks.focus();
      } catch {
        submitBtn.disabled = false;
        submitBtn.querySelector('span')!.textContent = 'Submit';
        if (formError) {
          formError.hidden = false;
          formError.textContent = 'The message could not be sent. Please try again.';
        }
      }
    });
  }
</script>
