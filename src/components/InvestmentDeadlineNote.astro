---
import { REAL_ESTATE_THRESHOLD_NOTE } from '../data/program-faq';

interface Props {
  variant?: 'on-navy' | 'on-paper';
}

const { variant = 'on-paper' } = Astro.props;
---

<aside class:list={['deadline', variant === 'on-navy' && 'deadline--on-navy']} role="note">
  <p class="label">Investment thresholds</p>
  <p>{REAL_ESTATE_THRESHOLD_NOTE}</p>
</aside>

<style>
  .deadline {
    border: 1px solid var(--color-line);
    background: var(--color-cream);
    border-radius: 2px;
    box-shadow: none;
    padding: 1.15rem 1.25rem;
    margin: 1.5rem 0 0;
    text-align: left;
    max-width: 42rem;
  }

  .deadline--on-navy {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.08);
    margin: 1.75rem 0 0;
  }

  .label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-ui);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    /* Chip sits on cream; #75767a fails on the tinted fill. Keep old muted. */
    color: #5c5e62;
    background: rgba(64, 83, 99, 0.08);
    border-radius: 2px;
    box-shadow: none;
    padding: 0.35em 0.75em;
    margin: 0 0 0.55rem;
  }

  .deadline--on-navy .label {
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.12);
  }

  .deadline p:last-child {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--color-ink);
  }

  .deadline--on-navy p:last-child {
    color: var(--color-on-navy);
  }
</style>
