---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/visa', label: 'The Visa' },
  { href: '/benefits', label: 'Benefits' },
  { href: '/who-its-for', label: "Who It's For" },
  { href: '/process', label: 'Process' },
  { href: '/eligibility', label: 'Eligibility' },
  { href: '/faq', label: 'FAQ' },
  { href: '/papers', label: 'Papers' },
  { href: '/#book', label: 'Speak to an Advisor', emphasis: true },
];
---

<header class="navbar" id="navbar">
  <div class="wrap inner">
    <a class="brand" href="/">
      <svg class="mark" width="32" height="32" viewBox="0 0 36 40" aria-hidden="true">
        <path
          fill="currentColor"
          d="M18 1.2c4.4 3 9.2 4.5 14.8 4.5v14.2c0 8.8-5.7 16-14.8 19.6C8.9 35.9 3.2 28.7 3.2 19.9V5.7C8.8 5.7 13.6 4.2 18 1.2Z"
        ></path>
        <path
          fill="none"
          stroke="var(--color-paper)"
          stroke-width="1.2"
          d="M18 8.2c2.6 1.6 5.4 2.4 8.6 2.4v8.4c0 5-3.2 9.2-8.6 11.3-5.4-2.1-8.6-6.3-8.6-11.3V10.6c3.2 0 6-0.8 8.6-2.4Z"
        ></path>
      </svg>
      <span class="brand-name">Panama Qualified Investor</span>
    </a>

    <div class="end">
      <nav class="links" aria-label="Primary">
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={[link.emphasis && 'emphasis', path === link.href && 'is-active']}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <button class="burger" type="button" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav">
        <span></span>
        <span></span>
        <span></span>
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>

  <div class="overlay" id="mobile-nav" data-nav-panel>
    <button class="close" type="button" data-nav-close aria-label="Close menu">✕</button>
    <nav class="overlay-links" aria-label="Mobile">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-close
            class:list={[link.emphasis && 'emphasis', path === link.href && 'is-active']}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  :global(:root) {
    --header-h: 80px;
  }

  @media (min-width: 1024px) {
    :global(:root) {
      --header-h: 80px;
    }
  }

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 80px;
    background: #fff;
    border-bottom: 1px solid #e5e5e5;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
    max-width: none;
    width: 100%;
    margin-inline: 0;
    padding-inline: clamp(1.5rem, 3vw, 2.5rem);
  }

  .brand {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.6rem;
    z-index: 2;
    flex-shrink: 0;
    margin: 0;
  }

  .mark {
    width: 32px;
    height: 32px;
    color: var(--color-ink);
    display: block;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-top: 0;
    margin-top: 0;
    border-top: none;
    line-height: 1.2;
    white-space: nowrap;
  }

  .end {
    display: flex;
    align-items: center;
    height: 100%;
    margin-left: auto;
    flex-shrink: 0;
  }

  .links {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: 0;
    height: 100%;
    margin-left: auto;
    flex-shrink: 0;
  }

  .links a {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 450;
    color: #4b4b4b;
    text-transform: none;
    letter-spacing: 0;
    padding: 0 0.85rem;
    height: 80px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    box-sizing: border-box;
    margin-bottom: -1px;
    flex-shrink: 0;
    transition:
      color 150ms ease-out,
      border-color 150ms ease-out,
      background-color 150ms ease-out;
  }

  .links a:hover:not(.emphasis),
  .links a.is-active:not(.emphasis) {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .links a.emphasis {
    height: auto;
    margin-left: 0.5rem;
    margin-bottom: 0;
    padding: 0.5rem 1.1rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    border: 1.5px solid var(--color-ink);
    border-radius: 4px;
    background: transparent;
  }

  .links a.emphasis:hover,
  .links a.emphasis.is-active {
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
  }

  @media (max-width: 1280px) {
    .links a {
      font-size: 0.85rem;
      padding: 0 0.6rem;
    }

    .links a.emphasis {
      font-size: 0.78rem;
      padding: 0.5rem 1.1rem;
    }
  }

  .burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    z-index: 2;
  }

  .burger span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--color-ink);
  }

  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #fff;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.5rem 3rem;
  }

  .overlay.is-open {
    display: flex;
  }

  .close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.35rem;
  }

  .overlay-links {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .overlay-links a {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: 0;
    text-transform: none;
    padding: 0.75rem 0;
  }

  .overlay-links a.emphasis,
  .overlay-links a.is-active {
    font-weight: 600;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 1024px) {
    .links {
      display: flex;
    }

    .burger,
    .overlay {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const panel = document.querySelector('[data-nav-panel]');
  if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => {
      setOpen(!panel.classList.contains('is-open'));
    });
    panel.querySelectorAll('[data-nav-close]').forEach((el) => {
      el.addEventListener('click', () => setOpen(false));
    });
    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 1024px)').matches) setOpen(false);
    });
  }
</script>
