---
import Logo from './Logo.astro';
import AdvisorModal from './AdvisorModal.astro';
import AdvisorContactModal from './AdvisorContactModal.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/panama-qualified-investor-visa-2026', label: 'The Visa' },
  { href: '/panama-qualified-investor-visa-benefits', label: 'Benefits' },
  { href: '/who-is-the-panama-qualified-investor-visa-for', label: "Who It's For" },
  { href: '/panama-qualified-investor-visa-process-2026', label: 'Process' },
  { href: '/panama-qualified-investor-visa-eligibility', label: 'Eligibility' },
  { href: '/panama-qualified-investor-visa-cost', label: 'Cost' },
  { href: '/panama-qualified-investor-visa-faq', label: 'FAQ' },
  { href: '/panama-qualified-investor-visa-research-papers', label: 'Papers' },
];
---

<header class="navbar" id="navbar">
  <div class="wrap inner">
    <a class="brand" href="/">
      <Logo priority />
    </a>

    <div class="end">
      <nav class="links" aria-label="Primary">
        {
          links.map((link) => (
            <a href={link.href} class:list={[path === link.href && 'is-active']}>
              {link.label}
            </a>
          ))
        }
        <button
          class="emphasis"
          type="button"
          data-advisor-open
          aria-haspopup="dialog"
          aria-controls="advisor-modal"
        >
          Speak to an Advisor
        </button>
      </nav>

      <button class="burger" type="button" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav">
        <span></span>
        <span></span>
        <span></span>
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>

  <div class="overlay" id="mobile-nav" data-nav-panel>
    <button class="close" type="button" data-nav-close aria-label="Close menu">✕</button>
    <nav class="overlay-links" aria-label="Mobile">
        {
          links.map((link) => (
            <a
              href={link.href}
              data-nav-close
              class:list={[path === link.href && 'is-active']}
            >
              {link.label}
            </a>
          ))
        }
        <button
          class="emphasis"
          type="button"
          data-advisor-open
          aria-haspopup="dialog"
          aria-controls="advisor-modal"
        >
          Speak to an Advisor
        </button>
    </nav>
  </div>
</header>

<style>
  :global(:root) {
    --header-h: 80px;
  }

  @media (min-width: 1024px) {
    :global(:root) {
      --header-h: 80px;
    }
  }

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 80px;
    background: #fff;
    border-bottom: 1px solid #e5e5e5;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
    max-width: none;
    width: 100%;
    margin-inline: 0;
    padding-inline: clamp(1.5rem, 3vw, 2.5rem);
  }

  .brand {
    display: flex;
    flex-direction: row;
    align-items: center;
    z-index: 2;
    flex-shrink: 0;
    margin: 0;
  }

  .end {
    display: flex;
    align-items: center;
    height: 100%;
    margin-left: auto;
    flex-shrink: 0;
  }

  .links {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: 0;
    height: 100%;
    margin-left: auto;
    flex-shrink: 0;
  }

  .links a {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: var(--weight-ui);
    color: var(--color-link);
    text-transform: none;
    letter-spacing: 0;
    padding: 0 0.7rem;
    height: 80px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    position: relative;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: color 150ms ease-out;
  }

  .links a:not(.emphasis)::after {
    content: "";
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    bottom: 0;
    height: 2px;
    background: var(--color-navy-950);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 150ms ease-out, background-color 150ms ease-out;
    will-change: transform;
    pointer-events: none;
  }

  .links a:hover:not(.emphasis) {
    color: var(--color-link-hover);
  }

  .links a:hover:not(.emphasis)::after {
    transform: scaleX(1);
    background: var(--color-link-hover);
  }

  .links a.is-active:not(.emphasis) {
    color: var(--color-navy-950);
    font-weight: var(--weight-semibold);
  }

  .links a.is-active:not(.emphasis)::after {
    transform: scaleX(1);
    background: var(--color-navy-950);
  }

  .links a.emphasis,
  .links button.emphasis {
    height: auto;
    margin-left: 0.5rem;
    margin-bottom: 0;
    padding: 0.5rem 1.1rem;
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    border: 1.5px solid var(--color-ink);
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
  }

  .links a.emphasis:hover,
  .links a.emphasis.is-active,
  .links button.emphasis:hover {
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
  }

  @media (max-width: 1280px) {
    .links a:not(.emphasis) {
      padding: 0 0.5rem;
    }

    .links a:not(.emphasis)::after {
      left: 0.4rem;
      right: 0.4rem;
    }
  }

  .burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    z-index: 2;
  }

  .burger span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--color-ink);
  }

  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #fff;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 1.5rem 3rem;
  }

  .overlay.is-open {
    display: flex;
  }

  .close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.35rem;
  }

  .overlay-links {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .overlay-links a,
  .overlay-links button {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: 0;
    text-transform: none;
    padding: 0.75rem 0;
  }

  .overlay-links button {
    background: none;
    border: 0;
    cursor: pointer;
  }

  .overlay-links a.is-active,
  .overlay-links button.emphasis {
    font-weight: 600;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 1024px) {
    .links {
      display: flex;
    }

    .burger,
    .overlay {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const panel = document.querySelector('[data-nav-panel]');
  if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => {
      setOpen(!panel.classList.contains('is-open'));
    });
    panel.querySelectorAll('[data-nav-close]').forEach((el) => {
      el.addEventListener('click', () => setOpen(false));
    });
    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 1024px)').matches) setOpen(false);
    });
  }
</script>

<AdvisorModal />
<AdvisorContactModal />
