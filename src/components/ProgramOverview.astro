---
const routes = [
  {
    n: '01',
    kicker: 'Real estate',
    title: 'Titled Real Estate',
    body: 'Purchase property with clear title valued at $300,000 or more. Residential, commercial, or land — the asset must be registered in your name.',
    image: 'https://images.unsplash.com/photo-1637971405797-ccf327195cb1?w=800&q=80&auto=format&fit=crop',
    alt: 'Modern high-rise buildings in Panama City',
    href: '#investment',
  },
  {
    n: '02',
    kicker: 'Securities',
    title: 'Stocks & Securities',
    body: 'Invest $300,000 or more in securities listed on the Panama Stock Exchange through a licensed local brokerage. Equities, bonds, or funds qualify.',
    image: 'https://images.unsplash.com/photo-1540610410855-b4c8877b761c?w=800&q=80&auto=format&fit=crop',
    alt: 'Panama City financial district at night',
  },
  {
    n: '03',
    kicker: 'Bank deposit',
    title: 'Fixed-Term Bank Deposit',
    body: 'Place a $300,000 minimum in a three-year fixed-term deposit at a licensed Panamanian bank. The deposit is returned to you at term end.',
    image: 'https://images.unsplash.com/photo-1582059983736-eedd5df2212b?w=800&q=80&auto=format&fit=crop',
    alt: 'Panama City skyline during daytime',
  },
];
---

<section class="section" id="program">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow eyebrow--on-navy">The program</p>
      <h2>Three routes to Panamanian <em>residency.</em></h2>
      <p class="lede">
        The Qualified Investor Visa accepts a minimum investment of $300,000 in one of three qualifying categories.
      </p>
      <p class="note">
        Program terms and investment thresholds can change. Current requirements are valid as of 2026.
      </p>
    </div>
    <div class="grid">
      {
        routes.map((route, i) => (
          <article class="pcard rv" style={`--rv-delay: ${i * 0.1}s`}>
            <img src={route.image} alt={route.alt} width="800" height="600" loading="lazy" />
            <div class="pcard-body">
              <p class="num">{route.n}</p>
              <p class="kicker">{route.kicker}</p>
              <h3>{route.title}</h3>
              <p class="body">{route.body}</p>
              {route.href && (
                <a class="cta-link" href={route.href}>
                  Learn more
                  <span class="ring" aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
    <p class="section-more rv">
      <a class="cta-link cta-link--cream" href="/visa">
        View full program details
        <span class="ring" aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  .section {
    background: linear-gradient(200deg, #4e6478 0%, #405363 55%, #2d3d4d 100%);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .sec-head h2 {
    color: var(--color-on-navy);
  }

  .sec-head h2 em {
    color: rgba(255, 255, 255, 0.80);
  }

  .lede {
    color: var(--color-on-navy-dim);
    max-width: var(--measure);
    margin: var(--space-lede) auto 0;
    font-size: var(--text-body);
  }

  .note {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-gold-300);
    margin: 0.75rem 0 0;
  }

  .grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 3.5rem;
  }

  .num {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.4rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 0.35rem;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-ui);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-on-navy-dim);
    margin: 0 0 0.45rem;
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    color: var(--color-on-navy);
    margin: 0 0 0.55rem;
  }

  .body {
    font-size: var(--text-small);
    color: var(--color-on-navy-dim);
    margin: 0;
    line-height: var(--leading-body);
    font-weight: var(--weight-body);
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
