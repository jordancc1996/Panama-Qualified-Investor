---
import { FORMCARRY_ACTION } from '../lib/forms';
import LinkedInField from './LinkedInField.astro';
---

<section class="top-cta">
  <div class="wrap">
    <div class="cta-card">
      <p class="kicker">Panama Qualified Investor Newsletter</p>
      <h2>Never miss an update. Subscribe for the latest on Panama's investor residency program.</h2>
      <p class="sub">Program status, regulatory developments, and residency updates, delivered by email.</p>
      <form class="form" id="top-cta-form" action={FORMCARRY_ACTION} method="POST" accept-charset="UTF-8">
        <input type="hidden" name="_subject" value="Panama Qualified Investor newsletter" />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="row">
          <div class="field">
            <label for="first_name">
              First name<span style="color: #c0392b; margin-left: 0.15rem">*</span>
            </label>
            <input
              id="first_name"
              type="text"
              name="first_name"
              placeholder="Enter your first name"
              required
            />
          </div>
          <div class="field">
            <label for="last_name">
              Last name<span style="color: #c0392b; margin-left: 0.15rem">*</span>
            </label>
            <input
              id="last_name"
              type="text"
              name="last_name"
              placeholder="Enter your last name"
              required
            />
          </div>
        </div>
        <div class="field">
          <label for="phone">Phone</label>
          <input id="phone" type="tel" name="phone" placeholder="Enter your phone number" />
        </div>
        <div class="field">
          <label for="email">
            Email<span style="color: #c0392b; margin-left: 0.15rem">*</span>
          </label>
          <input
            id="email"
            type="email"
            name="email"
            placeholder="Enter your email"
            required
          />
        </div>
        <LinkedInField id="top-cta-linkedin" />
        <button class="submit" type="submit">Subscribe</button>
      </form>
      <p class="disclaimer">
        By submitting this form, you agree to receive email updates from Panama Qualified Investor. You may unsubscribe at any time. Read the <a href="/privacy" style="color: var(--color-ink); text-decoration: underline;">Privacy Policy</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .top-cta {
    padding: 3rem 0;
    background: transparent;
  }

  .cta-card {
    max-width: 38rem;
    margin-inline: auto;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 1.5rem;
    background: #fff;
    transition: box-shadow 150ms ease-out;
  }

  .cta-card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy-900);
    margin: 0 0 0.5rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2-sm);
    font-weight: 600;
    line-height: var(--leading-h3);
    color: var(--color-ink);
    margin: 0 0 0.85rem;
    letter-spacing: 0;
  }

  .sub {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-muted);
    margin: 0 0 1.5rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .field label {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.3rem;
    display: block;
  }

  .form input {
    width: 100%;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
    font-family: var(--font-sans);
    font-size: var(--text-input);
    color: var(--color-ink);
    outline: none;
  }

  .form input::placeholder {
    color: var(--color-muted);
  }

  .form input:focus,
  .form :global(.linkedin-field input:focus) {
    border-color: var(--color-navy-900);
    outline: none;
    box-shadow: none;
  }

  .form :global(.linkedin-field label) {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.3rem;
    display: block;
  }

  .form :global(.linkedin-field input) {
    width: 100%;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
    font-family: var(--font-sans);
    font-size: var(--text-input);
    color: var(--color-ink);
    outline: none;
  }

  .form :global(.linkedin-field input::placeholder) {
    color: var(--color-muted);
  }

  .form :global(.linkedin-field input[aria-invalid='true']) {
    border-color: #c0392b;
  }

  .form :global(.linkedin-field .err) {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    line-height: 1.4;
    color: #c0392b;
    margin: 0.35rem 0 0;
  }

  .submit {
    width: 100%;
    margin-top: 0.85rem;
    background: var(--color-navy-900);
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    cursor: pointer;
  }

  .submit:hover {
    background: var(--color-navy-800);
  }

  .disclaimer {
    margin-top: 1rem;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    line-height: var(--leading-footer);
    color: var(--color-muted);
  }

  @media (max-width: 639px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { linkedinFieldError, normalizeLinkedInUrl } from '../lib/linkedin';

  const form = document.getElementById('top-cta-form') as HTMLFormElement | null;
  const input = document.getElementById('top-cta-linkedin') as HTMLInputElement | null;
  const err = document.getElementById('top-cta-linkedin-error');

  const setLinkedInError = (message: string) => {
    if (!input || !err) return;
    const invalid = Boolean(message);
    input.setAttribute('aria-invalid', String(invalid));
    if (invalid) {
      err.hidden = false;
      err.textContent = message;
      input.setAttribute('aria-describedby', err.id);
    } else {
      err.hidden = true;
      err.textContent = '';
      input.removeAttribute('aria-describedby');
    }
  };

  if (form && input) {
    input.addEventListener('input', () => {
      if (input.getAttribute('aria-invalid') === 'true') {
        setLinkedInError(linkedinFieldError(input.value));
      }
    });
    input.addEventListener('blur', () => setLinkedInError(linkedinFieldError(input.value)));
    form.addEventListener('submit', (event) => {
      const message = linkedinFieldError(input.value);
      setLinkedInError(message);
      if (message) {
        event.preventDefault();
        input.focus();
        return;
      }
      const normalized = normalizeLinkedInUrl(input.value);
      if (normalized.ok) input.value = normalized.value;
    });
  }
</script>
