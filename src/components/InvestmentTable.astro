---
interface Props {
  embedded?: boolean;
  showManagement?: boolean;
}

const { embedded = false, showManagement = false } = Astro.props;

const rows = [
  {
    route: 'Real Estate',
    min: '$300,000; $500,000 from Oct 15, 2026',
    lock: 'None: own the property',
    key: "Titled property, registered in applicant's name",
    timeline: '30 to 90 days to provisional permit',
    management: 'Property maintenance, taxes, tenants',
  },
  {
    route: 'Securities',
    min: '$500,000',
    lock: 'Held for duration of visa',
    key: 'Through licensed Panamanian brokerage',
    timeline: '30 to 90 days to provisional permit',
    management: 'Portfolio monitoring through brokerage',
  },
  {
    route: 'Bank Deposit',
    min: '$750,000',
    lock: '5-year fixed term',
    key: 'Licensed Panamanian bank',
    timeline: '30 to 90 days to provisional permit',
    management: 'None: fully passive',
  },
];
---

{
  embedded ? (
    <div class="table-wrap scroll-reveal">
      <table class:list={[showManagement && 'wide']}>
        <thead>
          <tr>
            <th>Route</th>
            <th>Minimum Investment</th>
            <th>Lock-in Period</th>
            <th>Key Requirement</th>
            <th>Timeline</th>
            {showManagement && <th>Ongoing Management</th>}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <td class="route">{row.route}</td>
                <td>{row.min}</td>
                <td>{row.lock}</td>
                <td>{row.key}</td>
                <td>{row.timeline}</td>
                {showManagement && <td>{row.management}</td>}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  ) : (
    <section class="section" id="investment">
      <div class="wrap">
        <div class="sec-head scroll-reveal">
          <p class="eyebrow">Investment requirements</p>
          <h2>What qualifies, and what it costs.</h2>
          <p class="lede">
            Real estate is the lowest cash outlay. The current real estate minimum is $300,000; this is scheduled to increase to $500,000 on October 15, 2026. Securities require $500,000 held for the duration of residency. The bank deposit is $750,000 locked for five years. Lock-in periods, timelines, and ongoing management sit side by side on the visa page.
          </p>
        </div>
        <p class="section-more">
          <a class="cta-link cta-link--ink" href="/panama-qualified-investor-visa-2026#investment-routes">
            Compare the three routes
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .section {
    background: var(--color-paper);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .lede {
    color: var(--color-ink-soft);
    margin: var(--space-lede) 0 0;
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: 4px;
    border: 1px solid var(--color-line);
  }

  table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
  }

  table.wide {
    min-width: 48rem;
  }

  th {
    background: var(--color-navy-900);
    color: var(--color-on-navy-dim);
    font-family: var(--font-sans);
    font-size: var(--text-table);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    text-align: left;
    padding: 0.7rem 1rem;
  }

  td {
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: var(--text-table);
    vertical-align: top;
  }

  tbody tr:nth-child(even) td {
    background: color-mix(in oklab, var(--color-cream) 32%, var(--color-paper));
  }

  .route {
    font-weight: 500;
    color: var(--color-ink);
  }
</style>
