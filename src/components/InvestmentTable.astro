---
interface Props {
  embedded?: boolean;
  showManagement?: boolean;
}

const { embedded = false, showManagement = false } = Astro.props;

const rows = [
  {
    route: 'Real Estate',
    min: '$300,000',
    lock: 'None — own the property',
    key: "Titled property, registered in applicant's name",
    timeline: '30–60 days',
    management: 'Property maintenance, taxes, tenants',
  },
  {
    route: 'Securities',
    min: '$300,000',
    lock: 'Held for duration of visa',
    key: 'Through licensed Panamanian brokerage',
    timeline: '30–60 days',
    management: 'Portfolio monitoring through brokerage',
  },
  {
    route: 'Bank Deposit',
    min: '$300,000',
    lock: '3-year fixed term',
    key: 'Licensed Panamanian bank',
    timeline: '30–60 days',
    management: 'None — fully passive',
  },
];
---

{
  embedded ? (
    <div class="table-wrap rv" style="--rv-delay: 0.1s">
      <table class:list={[showManagement && 'wide']}>
        <thead>
          <tr>
            <th>Route</th>
            <th>Minimum Investment</th>
            <th>Lock-in Period</th>
            <th>Key Requirement</th>
            <th>Timeline</th>
            {showManagement && <th>Ongoing Management</th>}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <td class="route">{row.route}</td>
                <td>{row.min}</td>
                <td>{row.lock}</td>
                <td>{row.key}</td>
                <td>{row.timeline}</td>
                {showManagement && <td>{row.management}</td>}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  ) : (
    <section class="section" id="investment">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">Investment requirements</p>
          <h2>What qualifies — and <em>what it costs.</em></h2>
        </div>
        <div class="table-wrap rv" style="--rv-delay: 0.1s">
          <table>
            <thead>
              <tr>
                <th>Route</th>
                <th>Minimum Investment</th>
                <th>Lock-in Period</th>
                <th>Key Requirement</th>
                <th>Timeline</th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr>
                    <td class="route">{row.route}</td>
                    <td>{row.min}</td>
                    <td>{row.lock}</td>
                    <td>{row.key}</td>
                    <td>{row.timeline}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="note">
          All amounts in USD. Processing times are estimates and may vary. The investment must be maintained for the duration of the residency.
        </p>
      </div>
    </section>
  )
}

<style>
  .section {
    background: var(--color-paper);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .sec-head {
    margin-bottom: 2.5rem;
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: 14px;
    border: 1px solid var(--color-line);
  }

  table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
  }

  table.wide {
    min-width: 48rem;
  }

  th {
    background: var(--color-navy-900);
    color: var(--color-on-navy-dim);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: left;
    padding: 0.7rem 1rem;
  }

  td {
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: var(--text-small);
    vertical-align: top;
  }

  tbody tr:nth-child(even) td {
    background: color-mix(in oklab, var(--color-cream) 32%, var(--color-paper));
  }

  .route {
    font-weight: var(--weight-bold);
    color: var(--color-ink);
  }

  .note {
    font-size: var(--text-caption);
    color: var(--color-muted);
    margin: 1rem 0 0;
    line-height: var(--leading-body);
    max-width: var(--measure);
  }
</style>
