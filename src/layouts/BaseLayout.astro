---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import garamond500 from '@fontsource/eb-garamond/files/eb-garamond-latin-500-normal.woff2?url';
import roboto400 from '@fontsource/roboto/files/roboto-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  path?: string;
}

const {
  title = 'Panama Residency By Investment | Check Your Eligibility | Panama Qualified Investor',
  description = 'Panama Residency By Investment | Check Your Eligibility | Panama Qualified Investor',
  ogDescription = 'Panama Residency By Investment | Check Your Eligibility | Panama Qualified Investor',
  path = '',
} = Astro.props;

const canonical = `https://panamaqualifiedinvestor.com${path}`;
const isHome = !path || path === '/';
const ogImage = 'https://panamaqualifiedinvestor.com/images/Panama-Qualified-Invesotr-Visa3.webp';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://panamaqualifiedinvestor.com/#organization',
      name: 'Panama Qualified Investor',
      url: 'https://panamaqualifiedinvestor.com',
      logo: 'https://panamaqualifiedinvestor.com/logo.webp',
      email: 'info@panamaqualifiedinvestor.com',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://panamaqualifiedinvestor.com/#website',
      name: 'Panama Qualified Investor',
      url: 'https://panamaqualifiedinvestor.com',
      publisher: { '@id': 'https://panamaqualifiedinvestor.com/#organization' },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="rCoHpY0OepTd9BYXkkH6TTs1648nsINk3yMKwq-IsYk" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Panama Qualified Investor" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://news.google.com" crossorigin />
    <link rel="preload" as="image" href="/logo.webp" type="image/webp" fetchpriority="high" />
    <link rel="preload" href={garamond500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={roboto400} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Preferred Sources: Google identifies the site by domain. No publication ID in the current spec. -->
    <script is:inline async src="https://news.google.com/swg/js/v1/publisher.js"></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!isHome && <div class="scroll-progress" aria-hidden="true"></div>}
    <slot />
    <Footer />
    <script>
      import '../scripts/scrollAnimations.ts';
    </script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const bar = document.querySelector('.scroll-progress');
        if (bar) {
          window.addEventListener(
            'scroll',
            () => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
              bar.style.width = progress + '%';
            },
            { passive: true }
          );
        }

        if (window.innerWidth < 768) {
          document.querySelectorAll('.audience-grid, .pcard-grid, .spec-grid, .cta-cards').forEach((grid) => {
            const lastCard = grid.lastElementChild;
            if (lastCard) {
              const obs = new IntersectionObserver(
                ([e]) => {
                  if (e.isIntersecting) {
                    grid.style.maskImage = 'none';
                    grid.style.webkitMaskImage = 'none';
                    obs.disconnect();
                  }
                },
                { threshold: 0.8 }
              );
              obs.observe(lastCard);
            }
          });
        }
      });
    </script>
  </body>
</html>
