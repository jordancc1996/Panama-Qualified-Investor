---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { SITE_URL } from '../lib/site';
import garamond400 from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url';
import roboto400 from '@fontsource/roboto/files/roboto-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  path?: string;
  /** Optional above-the-fold image preloads (hub LCP, etc.). */
  preloadImages?: Array<{ href: string; type?: string; fetchpriority?: 'high' | 'low' | 'auto' }>;
  /** Absolute URL or site path. Defaults to the site share JPG. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  noindex?: boolean;
}

const {
  title = 'Panama Residency By Investment | Check Your Eligibility | Panama Qualified Investor',
  description = 'Panama Residency By Investment | Check Your Eligibility | Panama Qualified Investor',
  ogDescription = 'Panama Residency By Investment | Check Your Eligibility | Panama Qualified Investor',
  path = '',
  preloadImages = [],
  ogImage: ogImageProp,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  noindex = false,
} = Astro.props;

const canonical = `${SITE_URL}${path}`;
const isHome = !path || path === '/';
const defaultShare = `${SITE_URL}/images/panama-qualified-investor-visa-share.jpg`;
const ogImage = ogImageProp
  ? ogImageProp.startsWith('http')
    ? ogImageProp
    : `${SITE_URL}${ogImageProp.startsWith('/') ? '' : '/'}${ogImageProp}`
  : defaultShare;
const ogImageAlt = 'Panama Qualified Investor Visa';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'Panama Qualified Investor',
      url: SITE_URL,
      logo: `${SITE_URL}/logo.webp`,
      email: 'info@panamaqualifiedinvestor.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Calle Nicanor de Obarrio, C. 50',
        addressLocality: 'Panamá',
        addressCountry: 'PA',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: 'Panama Qualified Investor',
      url: SITE_URL,
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="rCoHpY0OepTd9BYXkkH6TTs1648nsINk3yMKwq-IsYk" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Panama Qualified Investor" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="preconnect" href="https://news.google.com" crossorigin />
    {
      preloadImages.map((img) => (
        <link
          rel="preload"
          as="image"
          href={img.href}
          type={img.type || 'image/webp'}
          fetchpriority={img.fetchpriority || 'high'}
        />
      ))
    }
    <link rel="preload" href={garamond400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={roboto400} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Preferred Sources: Google identifies the site by domain. No publication ID in the current spec.
         Part 1 (prod): publisher.js ~143KB transfer, ~5–10ms main-thread; below 50ms defer threshold. Left as async. -->
    <script is:inline async src="https://news.google.com/swg/js/v1/publisher.js"></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!isHome && <div class="scroll-progress" aria-hidden="true"></div>}
    <slot />
    <Footer />
    <script>
      import '../scripts/scrollAnimations.ts';
    </script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const bar = document.querySelector('.scroll-progress');
        if (bar) {
          window.addEventListener(
            'scroll',
            () => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
              bar.style.width = progress + '%';
            },
            { passive: true }
          );
        }

        if (window.innerWidth < 768) {
          document.querySelectorAll('.audience-grid, .pcard-grid, .spec-grid, .cta-cards').forEach((grid) => {
            const lastCard = grid.lastElementChild;
            if (lastCard) {
              const obs = new IntersectionObserver(
                ([e]) => {
                  if (e.isIntersecting) {
                    grid.style.maskImage = 'none';
                    grid.style.webkitMaskImage = 'none';
                    obs.disconnect();
                  }
                },
                { threshold: 0.8 }
              );
              obs.observe(lastCard);
            }
          });
        }
      });
    </script>
  </body>
</html>
