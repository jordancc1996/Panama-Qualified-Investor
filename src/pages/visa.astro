---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import InvestmentTable from '../components/InvestmentTable.astro';

const routes = [
  {
    n: '01',
    title: 'Titled Real Estate',
    body: 'Purchase residential, commercial, or undeveloped land in Panama with clear title. The property must be valued at $300,000 or more and registered in your name. You own the asset outright and can sell it after maintaining it for the required period. Rental income from the property is subject to Panamanian income tax, but appreciation and foreign income are not.',
  },
  {
    n: '02',
    title: 'Stocks & Securities',
    body: 'Invest $300,000 or more in securities listed on the Panama Stock Exchange (Bolsa de Valores de Panamá) through a licensed local brokerage. Eligible instruments include equities, corporate bonds, government bonds, and investment funds. The investment must be maintained for the duration of your residency. Dividends and capital gains from the securities may be subject to Panamanian tax depending on the instrument.',
  },
  {
    n: '03',
    title: 'Fixed-Term Bank Deposit',
    body: 'Deposit $300,000 or more in a three-year fixed-term certificate of deposit (CD) at a licensed Panamanian bank. The deposit earns interest at the prevailing rate and the principal is returned to you at the end of the term. This is the most straightforward route — no property management, no brokerage selection, just a bank deposit.',
  },
];

const title = 'The Panama Qualified Investor Visa | Complete Overview';
const description =
  "Everything you need to know about Panama's Qualified Investor Visa. Three investment routes from $300,000, 30–60 day processing, permanent residency, and a path to citizenship.";
---

<BaseLayout title={title} description={description} ogDescription={description} path="/visa">
  <Navbar />
  <main id="main">
    <section class="page-hero">
      <div class="content">
        <p class="eyebrow eyebrow--on-navy">The visa</p>
        <h1>Panama's Qualified Investor Visa — explained.</h1>
        <p class="subtext">
          A complete breakdown of the program, its three investment routes, and what permanent residency in Panama actually means in practice.
        </p>
      </div>
    </section>

    <section class="section paper">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left rv">
            <p class="eyebrow">Overview</p>
            <h2>What is the Qualified Investor Visa?</h2>
          </div>
          <div class="prose rv" style="--rv-delay: 0.1s">
            <p>
              The Qualified Investor Visa (Visa de Inversionista Calificado) is a permanent residency permit issued by Panama's National Immigration Service (Servicio Nacional de Migración). It was established to attract foreign investment into Panama's economy by offering a direct path to permanent residency for individuals who make a qualifying investment of at least $300,000.
            </p>
            <p>
              Unlike temporary visas or tourist permits, the QIV grants permanent legal status from day one. Holders can live, work, start a business, open bank accounts, and access Panama's healthcare and education systems. After five years of residency, QIV holders become eligible to apply for Panamanian citizenship and a passport.
            </p>
            <p>
              The program is open to citizens of any country. There are no nationality-based quotas, no language requirements, no cultural integration exams, and no interview. The primary requirement is the investment itself, along with standard documentation and a clean background check.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-cream-tint">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">Investment routes</p>
          <h2>Three ways to qualify.</h2>
        </div>
        <div class="route-grid">
          {
            routes.map((item, i) => (
              <article class="spec-card rv" style={`--rv-delay: ${i * 0.06}s`}>
                <p class="n">{item.n}</p>
                <p class="title">{item.title}</p>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section paper">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">Side by side</p>
          <h2>Comparing the three routes.</h2>
        </div>
        <InvestmentTable embedded showManagement />
      </div>
    </section>

    <section class="section bg-cream-tint">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left rv">
            <p class="eyebrow">Beyond residency</p>
            <h2>From permanent resident to citizen.</h2>
          </div>
          <div class="prose rv" style="--rv-delay: 0.1s">
            <p>
              After holding permanent residency for five consecutive years, you become eligible to apply for Panamanian citizenship through naturalization. The process requires demonstrating ties to the country — which can include property ownership, economic activity, or family connections — and passing a basic exam on Panamanian history and civics conducted in Spanish.
            </p>
            <p>
              Panamanian citizenship grants you a passport that provides visa-free or visa-on-arrival access to over 140 countries, including the European Schengen Area, the United Kingdom, and most of Latin America and Asia. Panama allows dual citizenship, so you are not required to renounce your existing nationality.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap cta-band-inner">
        <h2>Ready to take the next step?</h2>
        <a class="btn btn--gold" href="/#book">
          Book Your Free Assessment <span class="arr">→</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .narrow {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .sec-head {
    margin-bottom: 2.5rem;
  }

  .sec-head.left {
    text-align: left;
  }

  .route-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  @media (min-width: 1024px) {
    .route-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
