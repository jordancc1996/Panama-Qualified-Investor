---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const taxCards = [
  {
    title: '0% on Foreign Income',
    body: 'Investment income, remote salaries, and business profits earned outside Panama are not taxed.',
  },
  {
    title: 'No Capital Gains Tax (Foreign)',
    body: 'Gains from foreign stocks, crypto, and property sales are tax-free in Panama.',
  },
  {
    title: 'No Inheritance Tax',
    body: 'Panama does not levy estate or inheritance tax on foreign-held assets.',
  },
  {
    title: 'Low Local Rates',
    body: 'Income earned within Panama is taxed at progressive rates of 0–25%, with a generous personal exemption.',
  },
];

const lifestyle = [
  {
    title: 'Dollar Economy',
    body: 'No currency conversion. Panama uses the US dollar as its official currency. Your bank accounts, rent, and groceries are all in USD.',
  },
  {
    title: 'Modern Infrastructure',
    body: 'Panama City has fiber internet, international hospitals, a new metro system, and one of the busiest airports in the Americas.',
  },
  {
    title: 'Direct Flights',
    body: 'Tocumen Airport connects to Miami (2.5 hrs), New York (5 hrs), Houston (4 hrs), Madrid (10 hrs), and most Latin American capitals.',
  },
  {
    title: 'Affordable Living',
    body: 'A high quality of life at 40–60% less than comparable US or Canadian cities. Housing, dining, healthcare, and domestic help are significantly cheaper.',
  },
  {
    title: 'English Widely Spoken',
    body: "Panama's history with the Canal Zone means English is widely spoken in business, banking, healthcare, and the expat community.",
  },
  {
    title: 'No Natural Disaster Risk',
    body: 'Panama sits below the hurricane belt and has no active volcanoes. It has not experienced a major earthquake in recorded history.',
  },
];

const title = 'Benefits of the Panama Qualified Investor Visa';
const description =
  "Zero tax on foreign income, dollar economy, no language requirement, family inclusion, path to citizenship. Every benefit of Panama's QIV explained.";
---

<BaseLayout title={title} description={description} ogDescription={description} path="/benefits">
  <Navbar />
  <main id="main">
    <section class="page-hero">
      <div class="content">
        <p class="eyebrow eyebrow--on-navy">Benefits</p>
        <h1>What permanent residency in Panama gives you.</h1>
        <p class="subtext">
          Beyond the residency card — the practical, financial, and lifestyle advantages of being a Panamanian permanent resident.
        </p>
      </div>
    </section>

    <section class="section paper">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">Tax advantages</p>
          <h2>A territorial tax system built for global earners.</h2>
        </div>
        <div class="split">
          <div class="prose rv">
            <p>
              Panama uses a territorial tax system. This means only income earned within Panama's borders is subject to Panamanian income tax. Foreign-sourced income — including investment returns, dividends, capital gains, rental income from foreign properties, consulting fees from overseas clients, and salary from foreign employers — is completely exempt.
            </p>
            <p>
              This is not a special incentive or a temporary tax holiday. It is how Panama's tax code has always worked. The territorial principle applies to all residents equally, whether you are Panamanian-born or a naturalized citizen.
            </p>
            <p>
              For investors, entrepreneurs, and remote workers whose income is generated outside Panama, this means you can be a legal, permanent resident of a stable country without adding a second layer of income taxation. You still pay taxes where you are a tax citizen (e.g., the US or Canada), but Panama does not pile on.
            </p>
          </div>
          <div class="stack">
            {
              taxCards.map((item, i) => (
                <article class="spec-card rv" style={`--rv-delay: ${i * 0.06}s`}>
                  <p class="title">{item.title}</p>
                  <p>{item.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-cream-tint">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">Lifestyle</p>
          <h2>What daily life looks like.</h2>
        </div>
        <div class="life-grid">
          {
            lifestyle.map((item, i) => (
              <article class="spec-card rv" style={`--rv-delay: ${i * 0.06}s`}>
                <p class="title">{item.title}</p>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section paper">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left rv">
            <p class="eyebrow">Family & legal</p>
            <h2>Benefits that extend to your family.</h2>
          </div>
          <div class="prose rv" style="--rv-delay: 0.1s">
            <p>
              Your QIV application can include your spouse, dependent children under 25, and parents over 65 — all on a single application with no additional investment required. Each dependent receives their own permanent residency card with full rights to live and work in Panama.
            </p>
            <p>
              Permanent residency also gives you access to Panama's banking system, the ability to form a Panamanian corporation (Sociedad Anónima) or simplified company (SAS), and the legal standing to purchase property, sign contracts, and access the court system.
            </p>
            <p>
              After five years, the path to citizenship opens. Panamanian citizenship includes a passport with visa-free access to 140+ countries, voting rights, and the ability to pass citizenship to future children born in Panama. Panama allows dual citizenship — no renunciation required.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap cta-band-inner">
        <h2>Ready to take the next step?</h2>
        <a class="btn btn--gold" href="/#book">
          Book Your Free Assessment <span class="arr">→</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .narrow {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .sec-head.left {
    text-align: left;
  }

  .split {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
    align-items: start;
  }

  .stack {
    display: grid;
    gap: 1rem;
  }

  .life-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }

  @media (min-width: 1024px) {
    .split {
      grid-template-columns: 1fr 1fr;
    }

    .life-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
