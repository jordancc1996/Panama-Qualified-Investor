---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import TopCTA from '../components/TopCTA.astro';
import MonthlyUpdates from '../components/MonthlyUpdates.astro';
import InvestmentDeadlineNote from '../components/InvestmentDeadlineNote.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import FAQSection from '../components/FAQSection.astro';
import ProgramFAQSection from '../components/ProgramFAQSection.astro';

const heroImage = '/images/hero-americans.webp';
const heroWidth = 1024;
const heroHeight = 714;

const benefits = [
  {
    title: 'No Worldwide Taxation',
    body: 'Panama\'s territorial system means your US-sourced income, investments, and capital gains are not taxed by Panama. You only deal with the IRS.',
  },
  {
    title: 'Dollar-Denominated',
    body: 'Panama uses the US dollar as its official currency. No conversion fees, no currency risk, no surprises on your bank statements.',
  },
  {
    title: 'No Renunciation Required',
    body: 'Permanent residency in Panama has zero impact on your US citizenship. Keep your passport, your rights, and your voting ability.',
  },
  {
    title: 'FATCA-Friendly Banking',
    body: 'Panamanian banks are accustomed to working with US clients and comply with FATCA reporting. Opening an account is straightforward.',
  },
  {
    title: 'Direct Flights Everywhere',
    body: 'Tocumen International Airport has direct flights to Miami (2.5 hrs), New York (5 hrs), Houston (4 hrs), and Los Angeles (6 hrs).',
  },
  {
    title: 'Familiar Legal System',
    body: 'Panama\'s legal framework for property ownership and business formation is well-established. US investors have operated here for over a century, since the Canal.',
  },
];

const faqs = [
  {
    q: 'Do I still have to pay US taxes if I move to Panama?',
    a: 'Yes. The US taxes citizens on worldwide income regardless of where they live. However, Panama does not add a second layer of taxation. Your US tax situation stays the same. You don\'t gain a new tax burden, and you may qualify for the Foreign Earned Income Exclusion or Foreign Tax Credit depending on your situation.',
  },
  {
    q: 'Does this affect my Social Security or Medicare?',
    a: 'No. Holding Panamanian residency has no impact on your Social Security benefits or Medicare eligibility. You continue to accrue benefits as normal. If you retire in Panama, Social Security payments can be deposited directly into a US or Panamanian bank account.',
  },
  {
    q: 'Can I keep my US bank accounts and brokerage?',
    a: 'Yes. Panamanian residency does not require you to move your financial accounts. Most Americans maintain their US banking, brokerage, and retirement accounts while opening a local Panamanian account for daily expenses.',
  },
  {
    q: 'What if I only want to spend part of the year in Panama?',
    a: 'That\'s fine. You can keep a US home and split the year. Days in Panama for the visa are not the same test as the IRS substantial-presence or Foreign Earned Income Exclusion rules.',
  },
  {
    q: 'Is $300,000 refundable if I change my mind?',
    a: 'The capital stays in your name as an asset, which is how it should be treated for IRS reporting. It is not a fee paid to the government. A bank deposit is returned after the five-year term. Real estate can be sold after the required holding period. Securities remain in your brokerage and can be traded. The $300,000 real estate investment minimum is scheduled to rise to $500,000 on October 15, 2026.',
  },
];
---

<BaseLayout
  title="Panama Qualified Investor Visa for Americans | Tax-Efficient Plan B"
  description="How US citizens use the Panama QIV for permanent residency. Zero tax on foreign income. Current real estate minimum $300,000, rising to $500,000 on October 15, 2026."
  ogDescription="How US citizens use the Panama QIV for permanent residency. Zero tax on foreign income. Current real estate minimum $300,000, rising to $500,000 on October 15, 2026."
  path="/americans"
>
  <Navbar />
  <main id="main">
    <section class="hero" id="top">
      <img
        class="hero-bg"
        src={heroImage}
        alt="Panamanian flag waving against a blue sky"
        width={heroWidth}
        height={heroHeight}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="content">
        <p class="eyebrow eyebrow--on-navy">For Americans</p>
        <h1>
          The Panama Qualified Investor Visa for Americans: a tax-efficient Plan B that doesn't require giving anything up.
        </h1>
        <p class="subtext">
          How US citizens and residents are using the <a href="/panama-qualified-investor-visa-2026">Panama Qualified Investor Visa</a> to secure permanent residency abroad, without renouncing citizenship, triggering new tax obligations, or leaving their lives behind.
        </p>
        <div class="actions">
          <a class="btn btn--gold" href="/#book">
            Speak with an Advisor
          </a>
        </div>
      </div>
    </section>
    <MonthlyUpdates />

    <section class="section paper">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left scroll-reveal">
            <p class="eyebrow">The reality</p>
            <h2>Why more Americans are looking beyond US borders.</h2>
          </div>
          <div class="prose">
            <p>
              The conversation has shifted. Five years ago, second residency was something ultra-high-net-worth families discussed with their wealth managers. Today, it's <a href="/who-is-the-panama-qualified-investor-visa-for">founders, tech workers, remote professionals</a>, and retirees asking the same question: what's my backup plan?
            </p>
            <p>
              The reasons vary. Some are watching the political landscape and want optionality. Others are thinking about retirement in a lower-cost, dollar-denominated economy. Many are simply diversifying: the same way they diversify their investments, they want to diversify where they have the legal right to live.
            </p>
            <p>
              The challenge for Americans is that most international residency programs create tax complications. The US taxes its citizens on worldwide income regardless of where they live, so moving abroad doesn't reduce your tax burden unless you renounce citizenship, which most people don't want to do.
            </p>
            <p>
              Panama is different. Its <a href="/panama-qualified-investor-visa-benefits">territorial tax system</a> only taxes income earned inside Panama. If you're an American living in Panama on investment income, remote work for a US company, or capital gains from US markets, Panama doesn't tax any of it. You still file with the IRS as you always have, but you don't add a second country's tax authority on top of it.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-cream-tint">
      <div class="wrap">
        <div class="sec-head scroll-reveal">
          <p class="eyebrow">Why Panama works for Americans</p>
          <h2>Built for your situation.</h2>
        </div>
        <div class="cards cta-cards scroll-reveal" data-reveal="stagger">
          {
            benefits.map((item, i) => (
              <article class="card">
                <p class="card-title">{item.title}</p>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section paper">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left scroll-reveal">
            <p class="eyebrow">How the visa works</p>
            <h2>Three routes to the same residency.</h2>
          </div>
          <InvestmentDeadlineNote />
          <p class="route-pointer">
            The Qualified Investor Visa has three paths: real estate, listed securities from $500,000, or a $750,000 fixed-term deposit. The current real estate minimum is $300,000; this is scheduled to increase to $500,000 on October 15, 2026. See the <a href="/panama-qualified-investor-visa-2026#investment-routes">full breakdown of all three routes</a>.
          </p>
          <p class="note">
            Processing is 30 to 90 days from document submission to provisional permit. See the <a href="/panama-qualified-investor-visa-process-2026">process</a>.
          </p>
        </div>
      </div>
    </section>

    <FAQSection
      items={faqs}
      eyebrow="Common questions"
      heading="Questions Americans ask most."
      id="page-faq"
      background="cream"
    />
    <ProgramFAQSection background="paper" />
    <section class="cta-band">
      <div class="wrap">
        <div class="cta-inner">
          <h2>Ready to explore your options?</h2>
          <p>15 minutes with an advisor who works specifically with American clients.</p>
          <button
            class="btn btn--gold"
            type="button"
            data-advisor-contact-open
            aria-haspopup="dialog"
            aria-controls="advisor-contact-modal"
          >
            Speak with an Advisor
          </button>
          <p class="cta-mail">
            Or email us at <a href="mailto:info@panamaqualifiedinvestor.com">info@panamaqualifiedinvestor.com</a>
          </p>
        </div>
      </div>
    </section>
    <TopCTA />
  </main>
  <FaqJsonLd items={faqs} />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: var(--header-h);
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(45, 61, 77, 0.96) 16%,
      rgba(45, 61, 77, 0.72) 50%,
      rgba(45, 61, 77, 0.38)
    );
    pointer-events: none;
  }

  .content {
    text-align: center;
    max-width: var(--measure);
    width: 100%;
    margin-inline: auto;
    padding: 4rem clamp(1.35rem, 5vw, 3rem);
    box-sizing: border-box;
  }

  h1 {
    color: var(--color-on-navy);
    margin: 1.1rem 0 0;
    overflow-wrap: break-word;
  }

  .subtext {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-on-navy-dim);
    margin: 1.5rem auto 0;
  }

  .actions {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .paper {
    background: var(--color-paper);
  }

  .narrow {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .sec-head.left {
    text-align: left;
  }

  .sec-head.left h2 {
    margin-top: var(--space-eyebrow);
  }

  .prose p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-paragraph);
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .cards {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .card {
    background: var(--color-paper);
    border-radius: 6px;
    border: 1px solid var(--color-line);
    padding: 1.5rem;
    transition: box-shadow 150ms ease-out;
  }

  .card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .card-title {
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    font-size: var(--text-body);
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }

  .card p:last-child {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-ink-soft);
    line-height: var(--leading-body);
  }

  .route-pointer {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--color-ink-soft);
    line-height: var(--leading-body);
    margin: 1.5rem 0 0;
  }

  .note {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-muted);
    margin: 1.5rem 0 0;
    text-align: center;
    line-height: var(--leading-body);
  }

  .cta-band {
    background: linear-gradient(200deg, #4e6478 0%, #405363 55%, #2d3d4d 100%);
    padding-block: var(--section-pad);
    text-align: center;
  }

  .cta-inner {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .cta-band h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    color: var(--color-on-navy);
    line-height: var(--leading-heading);
  }

  .cta-band p:not(.cta-mail) {
    color: var(--color-on-navy-dim);
    margin: var(--space-lede) 0 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .cta-band .btn {
    margin-top: 1.5rem;
  }

  .cta-mail {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: var(--weight-ui);
    color: rgba(255, 255, 255, 0.72);
    margin-top: 1.25rem;
    letter-spacing: var(--tracking-ui);
  }

  .cta-mail a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
