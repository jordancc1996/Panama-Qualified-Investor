---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import TopCTA from '../components/TopCTA.astro';
import ProgramFAQSection from '../components/ProgramFAQSection.astro';
import { FORMCARRY_ACTION } from '../lib/forms';
import {
  formatResearchDate,
  getPublishedResearch,
  researchHref,
  typeLabel,
} from '../lib/research';

const items = await getPublishedResearch();
const reportCount = items.filter((item) => item.data.type === 'report').length;
const briefCount = items.filter((item) => item.data.type === 'brief').length;

const coverImage = '/images/panama-investment-outlook-cover.webp';
const coverWidth = 720;
const coverHeight = 932;

const title = 'Panama Qualified Investor Visa Research';
const description =
  'Panama Qualified Investor Visa research reports and shorter briefs on Decree 17 of 2026, with downloadable PDFs and practical guidance.';

const tabs = [
  { id: 'filter-all', href: '?type=all#filter-all', label: 'All', type: 'all' as const },
  { id: 'filter-reports', href: '?type=reports#filter-reports', label: 'Reports', type: 'reports' as const },
  { id: 'filter-briefs', href: '?type=briefs#filter-briefs', label: 'Briefs', type: 'briefs' as const },
];
---

<BaseLayout
  title={title}
  description={description}
  ogDescription={description}
  path="/panama-qualified-investor-visa-research-papers"
  preloadImages={[{ href: coverImage, type: 'image/webp', fetchpriority: 'high' }]}
>
  <Navbar />
  <main id="main">
    <span id="filter-all" class="filter-anchor" tabindex="-1"></span>
    <span id="filter-reports" class="filter-anchor" tabindex="-1"></span>
    <span id="filter-briefs" class="filter-anchor" tabindex="-1"></span>

    <section class="research-open">
      <div class="open-grid">
        <div class="open-copy">
          <p class="eyebrow">Research</p>
          <h1>Panama Qualified Investor Visa Research and Reports</h1>
          <p class="intro">
            Panama Qualified Investor publishes in-depth research reports and shorter research briefs on the Qualified Investor Visa under Executive Decree 17 of 2026. Reports cover the market and the program in depth, with a downloadable PDF. Briefs answer one practical question, from choosing an investment route to preparing source-of-funds documents.
          </p>
        </div>
        <div class="open-cover" aria-hidden="false">
          <div class="cover-panel">
            <img
              class="cover-img"
              src={coverImage}
              alt="Cover of the Panama Investment Outlook research report"
              width={coverWidth}
              height={coverHeight}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <nav class="filter-band" aria-label="Filter research by type">
      <div class="wrap filter-inner">
        {
          tabs.map((tab, i) => (
            <>
              {i > 0 && <span class="rule" aria-hidden="true" />}
              <a class={`tab tab--${tab.type}`} href={tab.href}>
                {tab.label}
              </a>
            </>
          ))
        }
      </div>
    </nav>

    <section class="section paper research-list-section">
      <div class="wrap list">
        {
          items.length === 0 ? (
            <p class="empty">No research is published yet.</p>
          ) : (
            items.map((item) => (
              <article class="entry" data-type={item.data.type}>
                <div class="info">
                  <p class="label">{typeLabel(item.data.type)}</p>
                  <h2 class="title">
                    <a href={researchHref(item)}>{item.data.title}</a>
                  </h2>
                  <p class="desc">{item.data.description}</p>
                  <p class="meta">
                    <span>{item.data.topic}</span>
                    <span aria-hidden="true">·</span>
                    <time datetime={item.data.published.toISOString().slice(0, 10)}>
                      {formatResearchDate(item.data.published)}
                    </time>
                  </p>
                </div>
                {item.data.pdf && (
                  <a class="pdf" href={item.data.pdf} download>
                    PDF
                  </a>
                )}
              </article>
            ))
          )
        }
        {
          briefCount === 0 && (
            <p class="empty empty--for-briefs">The first research briefs are in preparation.</p>
          )
        }
        {
          reportCount === 0 && items.length > 0 && (
            <p class="empty empty--for-reports">The first research reports are in preparation.</p>
          )
        }
      </div>
    </section>

    <section class="section bg-cream-tint notify">
      <div class="wrap list">
        <p class="prompt">New research is added as it is published. Subscribe to get notified.</p>
        <form class="nl" action={FORMCARRY_ACTION} method="POST" accept-charset="UTF-8">
          <input type="hidden" name="_subject" value="Research newsletter signup" />
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
          <label class="sr-only" for="research-email">Email</label>
          <input
            id="research-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="Enter your email"
          />
          <button class="btn btn--navy" type="submit">
            Notify Me
          </button>
        </form>
        <p class="note">No spam. Just research.</p>
      </div>
    </section>
    <ProgramFAQSection background="paper" />
    <TopCTA />
  </main>
</BaseLayout>

<style>
  .filter-anchor {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .research-open {
    margin-top: var(--header-h);
    background: var(--color-paper);
  }

  .open-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: stretch;
  }

  .open-copy {
    padding: clamp(3rem, 6vw, 5rem) clamp(1.35rem, 4vw, 3rem);
    max-width: 40rem;
  }

  .open-copy h1 {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    color: var(--color-ink);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    margin: var(--space-eyebrow) 0 0;
  }

  .intro {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    color: var(--color-ink-soft);
    line-height: var(--leading-body);
    margin: 1.25rem 0 0;
    max-width: var(--measure);
  }

  .open-cover {
    background: #f7f7f7;
    min-height: 16rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.5rem;
  }

  .cover-panel {
    width: min(100%, 18rem);
  }

  .cover-img {
    display: block;
    width: 100%;
    height: auto;
    transform: rotate(3deg);
    box-shadow: 0 18px 40px rgba(45, 61, 77, 0.18);
    background: #fff;
  }

  @media (min-width: 900px) {
    .open-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: stretch;
    }

    .open-copy {
      padding-right: clamp(1.5rem, 4vw, 3rem);
      padding-left: clamp(1.35rem, 4vw, 3rem);
      margin-left: max(0px, calc((100vw - var(--wrap-max)) / 2));
    }

    .open-cover {
      justify-content: flex-end;
      padding: 3.5rem clamp(2rem, 5vw, 4rem) 3.5rem 2rem;
      /* Flush to the right edge of the viewport */
      width: 100%;
    }

    .cover-panel {
      width: min(100%, 20rem);
      margin-right: 0;
    }
  }

  .filter-band {
    background: #f7f7f7;
    border-block: 1px solid var(--color-line);
  }

  .filter-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding-block: 1rem;
  }

  .tab {
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    font-weight: var(--weight-ui);
    color: var(--color-ink);
    padding: 0.35rem 1rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition:
      color 150ms ease-out,
      border-color 150ms ease-out;
  }

  .tab:hover {
    color: var(--color-link-hover);
  }

  .rule {
    width: 1px;
    height: 1.1rem;
    background: var(--color-line);
    flex-shrink: 0;
  }

  /* Default active: All. CSS :target filters without JavaScript. */
  .tab--all {
    border-bottom-color: #405363;
  }

  :global(body:has(#filter-reports:target)) .tab--all,
  :global(body:has(#filter-briefs:target)) .tab--all {
    border-bottom-color: transparent;
  }

  :global(body:has(#filter-reports:target)) .tab--reports,
  :global(body:has(#filter-briefs:target)) .tab--briefs,
  :global(body:has(#filter-all:target)) .tab--all {
    border-bottom-color: #405363;
  }

  :global(body:has(#filter-reports:target)) .entry:not([data-type='report']),
  :global(body:has(#filter-briefs:target)) .entry:not([data-type='brief']) {
    display: none;
  }

  .list {
    max-width: 42rem;
    margin-inline: auto;
  }

  .research-list-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .entry {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .entry:first-child {
    padding-top: 0;
  }

  .entry:last-child {
    border-bottom: none;
  }

  .label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.45;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
    color: var(--color-ink);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-heading);
    margin: 0.35rem 0 0;
  }

  .title a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  .title a:hover {
    color: var(--color-link-hover);
  }

  .desc {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    color: var(--color-ink-soft);
    line-height: var(--leading-body);
    margin: 0.5rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-muted);
    margin: 0.65rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pdf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-cream);
    border-radius: 8px;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
    flex-shrink: 0;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }

  .pdf:hover {
    background: var(--color-navy-900);
    color: #fff;
  }

  @media (max-width: 639px) {
    .entry {
      flex-direction: column;
      gap: 0;
    }

    .pdf {
      margin-top: 0.75rem;
      align-self: flex-start;
    }
  }

  .empty {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    color: var(--color-ink-soft);
    line-height: var(--leading-body);
    margin: 0;
    max-width: var(--measure);
  }

  .empty--for-briefs,
  .empty--for-reports {
    display: none;
    margin-top: 0.25rem;
    color: var(--color-muted);
  }

  :global(body:has(#filter-briefs:target)) .empty--for-briefs,
  :global(body:has(#filter-reports:target)) .empty--for-reports {
    display: block;
  }

  .notify {
    padding-block: 3rem;
    text-align: center;
  }

  .prompt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    color: var(--color-ink-soft);
    margin: 0;
    line-height: var(--leading-body);
  }

  .nl {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin: 1.25rem auto 0;
    max-width: 24rem;
  }

  .nl input {
    flex: 1;
    min-width: 0;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
    font-family: var(--font-sans);
    font-size: var(--text-input);
    color: var(--color-ink);
    outline: none;
    transition: border-color 150ms ease-out;
  }

  .nl input::placeholder {
    color: var(--color-muted);
  }

  .nl input:focus {
    border-color: var(--color-navy-900);
  }

  .nl .btn {
    flex-shrink: 0;
  }

  .note {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0.75rem 0 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
