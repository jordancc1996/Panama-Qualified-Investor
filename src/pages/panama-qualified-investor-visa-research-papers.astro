---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import TopCTA from '../components/TopCTA.astro';
import MonthlyUpdates from '../components/MonthlyUpdates.astro';
import ProgramFAQSection from '../components/ProgramFAQSection.astro';
import { FORMCARRY_ACTION } from '../lib/forms';

const heroImage = '/images/hero-papers.webp';
const heroWidth = 682;
const heroHeight = 1024;

const papers = [
  {
    title: "Panama's Investment Outlook: Why the Qualified Investor Visa Appeals to Global Investors",
    author: 'Panama Qualified Investor Research Team',
    description:
      "This in-house paper covers Panama's investment outlook and why the Qualified Investor Visa may be attractive to investors considering residency through a qualifying investment.",
    href: '/documents/panama-investment-outlook-qiv.pdf',
  },
];

const title = 'Panama Qualified Investor Visa Research Papers';
const description =
  "Panama Qualified Investor Visa research papers on territorial taxation, investment migration, and residency planning by economists. Updated for 2026 investors.";
---

<BaseLayout title={title} description={description} ogDescription={description} path="/panama-qualified-investor-visa-research-papers">
  <Navbar />
  <main id="main">
    <section class="page-hero">
      <img
        class="hero-bg"
        src={heroImage}
        alt="The F&F Tower in Panama City, a teal glass spiral skyscraper against a clear sky"
        width={heroWidth}
        height={heroHeight}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="content">
        <p class="eyebrow eyebrow--on-navy">Research</p>
        <h1>Panama Qualified Investor Visa research papers <span class="amp">&amp;</span> reports.</h1>
        <p class="subtext">
          Panama Qualified Investor Visa research from economists, immigration attorneys, and policy advisors on investment migration, territorial taxation, and Panama's residency framework.
        </p>
      </div>
    </section>
    <MonthlyUpdates />

    <section class="section paper">
      <div class="wrap list">
        {
          papers.map((item) => (
            <article class="paper-item">
              <div class="info">
                <h2 class="title">{item.title}</h2>
                <p class="author">{item.author}</p>
                <p class="desc">{item.description}</p>
              </div>
              <a class="pdf" href={item.href} download>
                PDF
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section bg-cream-tint notify">
      <div class="wrap list">
        <p class="prompt">New papers are added as they're published. Subscribe to get notified.</p>
        <form class="nl" action={FORMCARRY_ACTION} method="POST" accept-charset="UTF-8">
          <input type="hidden" name="_subject" value="Papers newsletter signup" />
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
          <label class="sr-only" for="papers-email">Email</label>
          <input
            id="papers-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="Enter your email"
          />
          <button class="btn btn--navy" type="submit">
            Notify Me
          </button>
        </form>
        <p class="note">No spam. Just papers.</p>
      </div>
    </section>
    <ProgramFAQSection background="paper" />
    <TopCTA />
  </main>
</BaseLayout>

<style>
  .page-hero {
    overflow: hidden;
    isolation: isolate;
    background: none;
    min-height: 70vh;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42% 22%;
  }

  .page-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(45, 61, 77, 0.96) 16%,
      rgba(45, 61, 77, 0.72) 50%,
      rgba(45, 61, 77, 0.38)
    );
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 1;
  }

  .list {
    max-width: 42rem;
    margin-inline: auto;
  }

  .paper-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .paper-item:first-child {
    padding-top: 0;
  }

  .paper-item:last-child {
    border-bottom: none;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--color-ink);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-heading);
    margin: 0;
  }

  .author {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0.4rem 0 0;
    line-height: 1.45;
  }

  .desc {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    color: var(--color-ink-soft);
    line-height: var(--leading-body);
    margin: 0.5rem 0 0;
  }

  .pdf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-cream);
    border-radius: 8px;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
    flex-shrink: 0;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }

  .pdf:hover {
    background: var(--color-navy-900);
    color: #fff;
  }

  @media (max-width: 639px) {
    .paper-item {
      flex-direction: column;
      gap: 0;
    }

    .pdf {
      margin-top: 0.75rem;
      align-self: flex-start;
    }
  }

  .empty {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    color: var(--color-ink-soft);
    line-height: var(--leading-body);
    margin: 0;
    max-width: var(--measure);
  }

  .notify {
    padding-block: 3rem;
    text-align: center;
  }

  .prompt {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    color: var(--color-ink-soft);
    margin: 0;
    line-height: var(--leading-body);
  }

  .nl {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin: 1.25rem auto 0;
    max-width: 24rem;
  }

  .nl input {
    flex: 1;
    min-width: 0;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
    font-family: var(--font-sans);
    font-size: var(--text-input);
    color: var(--color-ink);
    outline: none;
    transition: border-color 150ms ease-out;
  }

  .nl input::placeholder {
    color: var(--color-muted);
  }

  .nl input:focus {
    border-color: var(--color-navy-900);
  }

  .nl .btn {
    padding: 0.75rem 1.3rem;
    font-size: var(--text-ui);
    min-height: 48px;
  }

  .note {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0.75rem 0 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
