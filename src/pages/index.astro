---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import WhyPanama from '../components/WhyPanama.astro';
import Audiences from '../components/Audiences.astro';
import Benefits from '../components/Benefits.astro';
import ProgramOverview from '../components/ProgramOverview.astro';
import InvestmentTable from '../components/InvestmentTable.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Eligibility from '../components/Eligibility.astro';
import CategorizedSiteFaq from '../components/CategorizedSiteFaq.astro';
import CTANextSteps from '../components/CTANextSteps.astro';
import Footer from '../components/Footer.astro';
import TopCTA from '../components/TopCTA.astro';
import MonthlyUpdates from '../components/MonthlyUpdates.astro';
import MobileCTABar from '../components/MobileCTABar.astro';
import SectionDivider from '../components/SectionDivider.astro';
---

<BaseLayout>
  <Navbar />
  <main id="main">
    <Hero />
    <MonthlyUpdates />
    <WhyPanama />
    <SectionDivider />
    <Audiences />
    <Benefits />
    <ProgramOverview />
    <InvestmentTable />
    <SectionDivider />
    <ProcessSteps />
    <Eligibility />
    <SectionDivider />
    <CategorizedSiteFaq />
    <CTANextSteps />
    <TopCTA />
  </main>
  <Footer />
  <MobileCTABar />
</BaseLayout>
