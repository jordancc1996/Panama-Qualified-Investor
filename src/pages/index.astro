---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import WhyPanama from '../components/WhyPanama.astro';
import Audiences from '../components/Audiences.astro';
import Benefits from '../components/Benefits.astro';
import ProgramOverview from '../components/ProgramOverview.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Eligibility from '../components/Eligibility.astro';
import FAQSection from '../components/FAQSection.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import CTANextSteps from '../components/CTANextSteps.astro';
import TopCTA from '../components/TopCTA.astro';
import MobileCTABar from '../components/MobileCTABar.astro';
import { programFaq } from '../data/program-faq';
import { financialFaq } from '../data/full-faq';

const homeFaqQuestions = [
  'What is the Panama Qualified Investor Visa?',
  'How long does the process take?',
  'Can I include my family?',
  'Do I need to live in Panama full-time?',
  'Is the $300,000 a fee or an investment?',
];

const homeFaqs = [
  ...programFaq.filter((item) => homeFaqQuestions.includes(item.q)),
  ...financialFaq.filter((item) => item.q === 'Is the $300,000 a fee or an investment?'),
].sort(
  (a, b) => homeFaqQuestions.indexOf(a.q) - homeFaqQuestions.indexOf(b.q),
);
---

<BaseLayout
  title="Panama Qualified Investor Visa: Residency from $300,000"
  description="Panama Qualified Investor Visa grants permanent residency from $300,000 via first-sale real estate, with a path to citizenship after five years of residence."
  ogDescription="Panama Qualified Investor Visa grants permanent residency from $300,000 via first-sale real estate, with a path to citizenship after five years of residence."
>
  <Navbar />
  <main id="main">
    <Hero />
    <WhyPanama />
    <Audiences />
    <Benefits />
    <ProgramOverview />
    <ProcessSteps />
    <Eligibility />
    <FAQSection
      id="faq-general"
      items={homeFaqs}
      eyebrow="FAQ"
      heading="Common questions."
      background="cream"
      align="start"
      closerHtml='More answers are in the <a href="/panama-qualified-investor-visa-faq">Panama Qualified Investor Visa FAQ</a>.'
    />
    <CTANextSteps />
    <TopCTA />
  </main>
  <MobileCTABar />
  <FaqJsonLd items={homeFaqs} />
</BaseLayout>
