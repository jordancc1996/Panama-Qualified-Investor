---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const requirements = [
  {
    title: 'Minimum $300,000 Investment',
    body: 'In one of three qualifying categories: titled real estate, listed securities, or a fixed-term bank deposit. The investment must be in your name.',
  },
  {
    title: 'Clean Criminal Background',
    body: 'You must pass a background check through Interpol and your country of residence. Serious criminal convictions disqualify applicants.',
  },
  {
    title: 'Proof of Legitimate Funds',
    body: 'You must demonstrate the source of your investment capital — employment income, business profits, investment returns, inheritance, or asset sales.',
  },
  {
    title: 'Valid Passport',
    body: 'From any country. At least 6 months remaining validity.',
  },
  {
    title: 'Health Certificate',
    body: 'A basic medical exam confirming you are free of communicable diseases.',
  },
  {
    title: 'No Panamanian Criminal Record',
    body: 'Applicants with existing legal issues in Panama are not eligible.',
  },
];

const notRequired = [
  {
    title: 'No Language Test',
    body: 'Unlike Portugal, France, or Germany, Panama does not require a Spanish exam for residency.',
  },
  {
    title: 'No Age Limit',
    body: 'The program is open to applicants of any age. There is no minimum or maximum.',
  },
  {
    title: 'No Interview',
    body: 'There is no immigration interview, no case officer meeting, and no panel review.',
  },
  {
    title: 'No Nationality Quotas',
    body: 'Every country is treated equally. No per-country caps, no priority dates, no backlogs.',
  },
  {
    title: 'No Minimum Stay',
    body: 'You do not need to live in Panama full-time. Visit once every two years to maintain status.',
  },
  {
    title: 'No Business Plan',
    body: 'Unlike investor visas in the US (E-2/EB-5) or UK, you do not need to create jobs or submit a business plan.',
  },
];

const title = "Eligibility for Panama's Qualified Investor Visa";
const description =
  "Who qualifies for Panama's QIV? Open to all nationalities, no age limit, no language test. Requirements: $300,000 investment, clean background, proof of funds.";
---

<BaseLayout title={title} description={description} ogDescription={description} path="/eligibility">
  <Navbar />
  <main id="main">
    <section class="page-hero">
      <div class="content">
        <p class="eyebrow eyebrow--on-navy">Eligibility</p>
        <h1>Who qualifies — and who doesn't.</h1>
        <p class="subtext">
          The QIV is designed to be accessible, but there are clear requirements. Here's the full picture.
        </p>
      </div>
    </section>

    <section class="section paper">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">Requirements</p>
          <h2>What you must have.</h2>
        </div>
        <div class="two-grid">
          {
            requirements.map((item, i) => (
              <article class="spec-card rv" style={`--rv-delay: ${i * 0.05}s`}>
                <p class="title">{item.title}</p>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section bg-cream-tint">
      <div class="wrap">
        <div class="sec-head rv">
          <p class="eyebrow">What you don't need</p>
          <h2>Barriers that don't exist here.</h2>
        </div>
        <div class="three-grid">
          {
            notRequired.map((item, i) => (
              <article class="spec-card rv" style={`--rv-delay: ${i * 0.05}s`}>
                <p class="title">{item.title}</p>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section paper">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left rv">
            <p class="eyebrow">Family</p>
            <h2>Who can be included.</h2>
          </div>
          <div class="prose rv" style="--rv-delay: 0.1s">
            <p>Your application can include the following dependents at no additional investment requirement:</p>
            <p>
              Your legal spouse — married or common-law, depending on applicable law. Your dependent children under the age of 25 — biological or legally adopted. Your parents or your spouse's parents over the age of 65.
            </p>
            <p>
              Each dependent receives their own permanent residency card with full rights to live and work in Panama. Dependent documents (passport, background check, health certificate) must be submitted alongside yours. There is no limit on the number of qualifying dependents.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-cream-tint">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left rv">
            <p class="eyebrow">Disqualifiers</p>
            <h2>Who does not qualify.</h2>
          </div>
          <div class="prose rv" style="--rv-delay: 0.1s">
            <p>
              The following will disqualify an application: a serious criminal conviction (felony-level offenses, fraud, money laundering, drug trafficking, terrorism); inability to demonstrate a legitimate source of funds; an active Interpol red notice; existing legal proceedings in Panama; or providing false or forged documents.
            </p>
            <p>
              Minor infractions (traffic violations, misdemeanors) generally do not disqualify applicants, but each case is assessed individually. If you have concerns about your background, raise them during the initial consultation — before investing time or money in the process.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap cta-band-inner">
        <h2>Ready to take the next step?</h2>
        <a class="btn btn--gold" href="/#book">
          Book Your Free Assessment <span class="arr">→</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .narrow {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .sec-head.left {
    text-align: left;
  }

  .two-grid,
  .three-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }

  @media (min-width: 1024px) {
    .two-grid {
      grid-template-columns: 1fr 1fr;
    }

    .three-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
