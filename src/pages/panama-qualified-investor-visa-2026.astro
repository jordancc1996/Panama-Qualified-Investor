---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import TopCTA from '../components/TopCTA.astro';
import CtaBand from '../components/CtaBand.astro';
import MonthlyUpdates from '../components/MonthlyUpdates.astro';
import InvestmentTable from '../components/InvestmentTable.astro';
import InvestmentDeadlineNote from '../components/InvestmentDeadlineNote.astro';
import FAQSection from '../components/FAQSection.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import {
  FUNDS_RULE,
  HOLD_PERIOD,
  REAL_ESTATE_THRESHOLD_NOTE,
  TRANSITION_NOTE,
} from '../data/program';

const pageFaqs = [
  {
    q: 'What investment options are available under the QIV?',
    a: `Three routes under Executive Decree 17 of 2026: titled real estate, listed securities, or a <a href="#investment-routes">fixed-term bank deposit</a>. ${REAL_ESTATE_THRESHOLD_NOTE} Listed securities start at US$500,000 on the Panama Stock Exchange (Bolsa de Valores de Panamá), purchased through a licensed local brokerage. Fixed-term deposits start at US$500,000 at a state bank or US$750,000 at a private bank. The investment must be held for ${HOLD_PERIOD}.`,
  },
  {
    q: 'Who issues the Qualified Investor Visa?',
    a: "Panama's National Immigration Service (Servicio Nacional de Migración) issues it as a permanent residency permit.",
  },
  {
    q: 'Are there nationality-based quotas?',
    a: 'No. The program is open to citizens of any country. There are no nationality-based quotas, unlike <a href="/h1b">H-1B</a> and similar capped work visas. The primary requirement is the investment itself, along with standard documentation and a <a href="/panama-qualified-investor-visa-eligibility">clean background check</a>.',
  },
];

const routes = [
  {
    n: '01',
    title: 'Titled Real Estate',
    body: 'Purchase residential, commercial, or undeveloped land in Panama with clear title. First-sale (new) property starts at US$300,000. Resale or secondary-market property starts at US$500,000. The property must be registered in your name. You own the asset outright and can sell it after maintaining it for the required hold period. Rental income from the property is subject to Panamanian income tax, but appreciation and foreign income are not.',
  },
  {
    n: '02',
    title: 'Stocks <span class="amp">&amp;</span> Securities',
    body: 'Invest US$500,000 or more in securities listed on the Panama Stock Exchange (Bolsa de Valores de Panamá) through a licensed local brokerage. Eligible instruments include equities, corporate bonds, government bonds, and investment funds. The investment must be maintained for five years after residency is granted, proven annually. Dividends and capital gains from the securities may be subject to Panamanian tax depending on the instrument.',
  },
  {
    n: '03',
    title: 'Fixed-Term Bank Deposit',
    body: 'Place a fixed-term deposit at a licensed Panamanian bank: US$500,000 at a state bank (Banco Nacional de Panamá or Caja de Ahorros), or US$750,000 at a private bank. The deposit earns interest at the prevailing rate and the principal is returned after the hold period. This is the most straightforward route: no property management, no brokerage selection, just a bank deposit.',
  },
];

const heroImage = '/images/hero-visa.webp';
const heroWidth = 1024;
const heroHeight = 585;

const title = 'Panama Qualified Investor Visa 2026 | Complete Overview';
const description =
  "How the Panama Qualified Investor Visa works. Three investment routes, processing that varies by case, permanent residency, and a path to citizenship.";
---

<BaseLayout title={title} description={description} ogDescription={description} path="/panama-qualified-investor-visa-2026">
  <Navbar />
  <main id="main">
    <section class="page-hero">
      <img
        class="hero-bg"
        src={heroImage}
        alt="Panamanian flag waving against a bright sky"
        width={heroWidth}
        height={heroHeight}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="content">
        <p class="eyebrow eyebrow--on-navy">The visa</p>
        <h1>Panama Qualified Investor Visa 2026</h1>
        <p class="subtext">
          A complete breakdown of how the Panama Qualified Investor Visa works, its three investment routes, and what permanent residency in Panama actually means in practice.
        </p>
      </div>
    </section>
    <MonthlyUpdates />

    <section class="section paper">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left scroll-reveal">
            <p class="eyebrow">Overview</p>
            <h2>What is the Qualified Investor Visa?</h2>
          </div>
          <div class="prose">
            <p>
              The Qualified Investor Visa (Visa de Inversionista Calificado) is a permanent residency permit issued by Panama's National Immigration Service (Servicio Nacional de Migración). Under Executive Decree No. 17 of September 8, 2026 (published and in force since September 16, 2026), it offers a <a href="/panama-qualified-investor-visa-process-2026">direct path to permanent residency</a> for individuals who make a qualifying investment in titled real estate, listed securities, or a fixed-term bank deposit. Decree 17 replaces earlier provisions under Decrees 722/2020 and 193/2024.
            </p>
            <p>
              What changed in September 2026: investment minima are now split by asset type (first-sale real estate from US$300,000; resale real estate, listed securities, and state-bank deposits from US$500,000; private-bank deposits from US$750,000). The investment must be held for five years after residency is granted, proven annually. {FUNDS_RULE} {TRANSITION_NOTE}
            </p>
            <p>
              Unlike temporary visas or tourist permits, the QIV grants permanent legal status from day one. Holders can live, work, <a href="/tech-founders">start a business</a>, open bank accounts, and access Panama's <a href="/panama-qualified-investor-visa-benefits">healthcare and education systems</a>. After five years of residency, QIV holders become eligible to apply for Panamanian citizenship and a passport.
            </p>
            <p>
              The program is open to citizens of any country. There are no nationality-based quotas, no language requirements, no cultural integration exams, and no interview. The primary requirement is the investment itself, along with standard documentation and a <a href="/panama-qualified-investor-visa-eligibility">clean background check</a>. Government fees sit on top of the investment; see <a href="/panama-qualified-investor-visa-cost">Panama Qualified Investor Visa Cost</a>. Further reading is in the <a href="/panama-qualified-investor-visa-research-papers">research papers</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-cream-tint" id="investment-routes">
      <div class="wrap">
        <div class="sec-head scroll-reveal">
          <p class="eyebrow">Investment routes</p>
          <h2>Three ways to qualify.</h2>
        </div>
        <InvestmentDeadlineNote />
        <div class="route-grid scroll-reveal" data-reveal="stagger">
          {
            routes.map((item, i) => (
              <article class="spec-card">
                <p class="n">{item.n}</p>
                <p class="title" set:html={item.title} />
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section paper">
      <div class="wrap">
        <div class="sec-head scroll-reveal">
          <p class="eyebrow">Side by side</p>
          <h2>Comparing the three routes.</h2>
        </div>
        <InvestmentTable embedded showManagement />
      </div>
    </section>

    <section class="section bg-cream-tint">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left scroll-reveal">
            <p class="eyebrow">Beyond residency</p>
            <h2>From permanent resident to citizen.</h2>
          </div>
          <div class="prose">
            <p>
              After holding permanent residency for five consecutive years, you become eligible to apply for Panamanian citizenship through naturalization. The process requires demonstrating ties to the country, which can include property ownership, economic activity, or family connections, and passing a basic exam on Panamanian history and civics conducted in Spanish.
            </p>
            <p>
              Panamanian citizenship grants you a passport with strong global mobility, voting rights, and the ability to pass citizenship to future children born in Panama. Panama allows dual citizenship, so you are not required to renounce your existing nationality.
            </p>
          </div>
        </div>
      </div>
    </section>

    <FAQSection
      items={pageFaqs}
      eyebrow="Common questions"
      heading="Routes, nationality, and tax."
      id="page-faq"
      background="paper"
      closerHtml='For more answers, <a href="/panama-qualified-investor-visa-faq">see the full FAQ</a>.'
    />
    <CtaBand />
    <TopCTA />
  </main>
  <FaqJsonLd items={pageFaqs} />
</BaseLayout>

<style>
  .page-hero {
    overflow: hidden;
    isolation: isolate;
    background: none;
    min-height: 70vh;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42% 40%;
  }

  .page-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(45, 61, 77, 0.96) 16%,
      rgba(45, 61, 77, 0.72) 50%,
      rgba(45, 61, 77, 0.38)
    );
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 1;
  }

  .narrow {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .sec-head {
    margin-bottom: 2.5rem;
  }

  #investment-routes {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .sec-head.left {
    text-align: left;
  }

  .route-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 1024px) {
    .route-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
