---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import TopCTA from '../components/TopCTA.astro';
import CtaBand from '../components/CtaBand.astro';
import MonthlyUpdates from '../components/MonthlyUpdates.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import FAQSection from '../components/FAQSection.astro';
import ProgramFAQSection from '../components/ProgramFAQSection.astro';
import { allFaqs, financialFaq, practicalFaq } from '../data/full-faq';

const heroImage = '/images/hero-faq.webp';
const heroWidth = 682;
const heroHeight = 1024;

const title = 'Panama Qualified Investor Visa FAQ - Common questions for 2026 applicants | Panama Qualified Investor';
const description =
  'Panama Qualified Investor Visa FAQ covers the $300,000 real estate minimum, rising to $500,000 on October 15, 2026, plus taxes, family, and processing.';
---

<BaseLayout title={title} description={description} ogDescription={description} path="/panama-qualified-investor-visa-faq">
  <Navbar />
  <main id="main">
    <section class="page-hero">
      <img
        class="hero-bg"
        src={heroImage}
        alt="A Panamanian flag on a tall pole against a bright overcast sky, framed by palm fronds"
        width={heroWidth}
        height={heroHeight}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="content">
        <p class="eyebrow eyebrow--on-navy">FAQ</p>
        <h1>Panama Qualified Investor Visa FAQ: every question, answered.</h1>
        <p class="subtext">Panama Qualified Investor Visa FAQ answers questions on taxes, family, costs, and citizenship.</p>
      </div>
    </section>
    <MonthlyUpdates />

    <ProgramFAQSection id="faq-general" background="cream" align="start" />

    <FAQSection
      id="faq-financial"
      items={financialFaq}
      eyebrow="Financial"
      heading="Money, taxes, and costs."
      background="paper"
      align="start"
    />
    <FAQSection
      id="faq-practical"
      items={practicalFaq}
      eyebrow="Practical"
      heading="Living in Panama."
      background="cream"
      align="start"
    />

    <CtaBand />
    <TopCTA />
  </main>
  <FaqJsonLd items={allFaqs} />
</BaseLayout>

<style>
  .page-hero {
    overflow: hidden;
    isolation: isolate;
    background: none;
    min-height: 70vh;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 45%;
  }

  .page-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(45, 61, 77, 0.96) 16%,
      rgba(45, 61, 77, 0.72) 50%,
      rgba(45, 61, 77, 0.38)
    );
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 1;
  }
</style>
