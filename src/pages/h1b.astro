---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import TopCTA from '../components/TopCTA.astro';
import MonthlyUpdates from '../components/MonthlyUpdates.astro';
import InvestmentDeadlineNote from '../components/InvestmentDeadlineNote.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';
import FAQSection from '../components/FAQSection.astro';
import ProgramFAQSection from '../components/ProgramFAQSection.astro';

const heroImage = '/images/hero-h1b.webp';
const heroWidth = 682;
const heroHeight = 1024;

const benefits = [
  {
    title: 'No Country Quotas',
    body: 'Unlike the US green card system, Panama\'s QIV has no per-country limits. Indian, Chinese, and all other nationals are processed identically on the same timeline.',
  },
  {
    title: 'No Employer Dependency',
    body: 'Your Panamanian residency belongs to you, not your employer. If you change jobs, get laid off, or start a company, your Panama status is unaffected.',
  },
  {
    title: 'Independent of the US backlog',
    body: 'Processing is 30 to 90 days from document submission to provisional permit.',
  },
  {
    title: 'H-1B Status Unaffected',
    body: 'Obtaining Panamanian residency has zero impact on your H-1B visa, your PERM filing, your I-140, or your position in the green card queue. It\'s a completely separate jurisdiction.',
  },
  {
    title: 'A Home You Actually Own',
    body: 'After years of temporary status in the US, Panama gives you something permanent. <a href="/panama-qualified-investor-visa-benefits">Legal residency that doesn\'t expire</a>, doesn\'t require renewal, and leads to citizenship in 5 years.',
  },
  {
    title: 'Family Coverage',
    body: 'Your spouse and dependent children are included in the same application. Your spouse receives their own residency permit with full work authorization in Panama: no EAD drama.',
  },
];

const faqs = [
  {
    q: 'Does getting Panama residency affect my H-1B or green card case?',
    a: 'No. Panamanian residency is a completely separate jurisdiction. It does not appear in USCIS records, does not affect your H-1B status, and does not change your priority date or position in the green card queue. US immigration law does not penalize you for holding residency in another country.',
  },
  {
    q: 'Can I do this while I\'m still in the US on an H-1B?',
    a: 'Yes. Most of the process can be done remotely: document preparation, background checks, and investment setup. You will need a short trip to Panama, typically just a day or two, to complete biometrics and finalize the application.',
  },
  {
    q: 'What if I get my green card later? Do I lose the Panama residency?',
    a: 'No. The two are independent. You can hold both US permanent residency (green card) and Panamanian permanent residency simultaneously. Many people maintain dual residency as part of a broader international strategy.',
  },
  {
    q: 'Is $300,000 realistic on an H-1B salary?',
    a: 'It depends on your specific situation. Many H-1B holders in tech, finance, and healthcare have savings, vested equity, or investment portfolios that meet the real estate threshold. The $300,000 real estate investment minimum is scheduled to rise to $500,000 on October 15, 2026. The bank deposit route ($750,000) means the money is not spent. It\'s held in a fixed-term deposit and returned to you after five years.',
  },
  {
    q: 'My spouse is on H-4 and can\'t work. Does Panama help?',
    a: 'Yes. As a dependent on your Panama QIV application, your spouse receives their own permanent residency permit with full work authorization in Panama. This is independent of H-4 or EAD status in the US.',
  },
];
---

<BaseLayout
  title="Panama Qualified Investor Visa for H-1B Holders | Backup Residency Plan"
  description="H-1B holders can skip the green card backlog. Panama Qualified Investor Visa processing is 30 to 90 days. Real estate from $300,000, rising October 15, 2026."
  ogDescription="H-1B holders can skip the green card backlog. Panama Qualified Investor Visa processing is 30 to 90 days. Real estate from $300,000, rising October 15, 2026."
  path="/h1b"
>
  <Navbar />
  <main id="main">
    <section class="hero" id="top">
      <img
        class="hero-bg"
        src={heroImage}
        alt="Panamanian flag on a flagpole among palm trees"
        width={heroWidth}
        height={heroHeight}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="content">
        <p class="eyebrow eyebrow--on-navy">For H-1B Visa Holders</p>
        <h1>
          The Panama Qualified Investor Visa for H-1B holders: a permanent residency that doesn't depend on a queue, a sponsor, or a lottery.
        </h1>
        <p class="subtext">
          How H-1B holders, especially those facing decade-long green card backlogs, are using the <a href="/panama-qualified-investor-visa-2026">Panama Qualified Investor Visa for H-1B holders</a> as a parallel path to permanent legal status outside the US.
        </p>
        <div class="actions">
          <a class="btn btn--gold" href="/#book">
            Speak with an Advisor
          </a>
        </div>
      </div>
    </section>
    <MonthlyUpdates />

    <section class="section paper">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left scroll-reveal">
            <p class="eyebrow">The reality</p>
            <h2>The green card backlog is a structural problem, not a temporary one.</h2>
          </div>
          <div class="prose">
            <p>
              If you're on an H-1B visa, you already know the wait. Employment-based green card processing for some nationalities can stretch for many years. Confirm current wait times with your US immigration counsel. <a href="/who-is-the-panama-qualified-investor-visa-for">Even for other nationalities</a>, EB-2 and EB-3 wait times have stretched beyond what most professionals planned for when they first came to the US.
            </p>
            <p>
              During that wait, your status is tied to your employer. You can't freely change jobs without restarting parts of the process. You can't start your own company in any practical way. Your spouse may or may not have work authorization depending on the current EAD policy. And if you're laid off, you have 60 days to find a new sponsor or leave the country.
            </p>
            <p>
              This isn't a system that's going to be fixed quickly. Immigration reform has been promised for decades and delivered in fragments. The rational response is not to wait. It's to build a backup.
            </p>
            <p>
              Panama's Qualified Investor Visa has nothing to do with the US immigration system. There's <a href="/panama-qualified-investor-visa-eligibility">no country-specific quota</a>, no employer sponsorship, no lottery, and no queue. You make a qualifying investment. The current real estate minimum is $300,000; this is scheduled to increase to $500,000 on October 15, 2026. You submit your documents and receive a provisional permit. Processing is 30 to 90 days from document submission to provisional permit. Your H-1B status is completely unaffected.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-cream-tint">
      <div class="wrap">
        <div class="sec-head scroll-reveal">
          <p class="eyebrow">Why Panama works for H-1B holders</p>
          <h2>Independence from a broken queue.</h2>
        </div>
        <div class="cards cta-cards scroll-reveal" data-reveal="stagger">
          {
            benefits.map((item, i) => (
              <article class="card">
                <p class="card-title">{item.title}</p>
                <p set:html={item.body} />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section paper">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left scroll-reveal">
            <p class="eyebrow">How the visa works</p>
            <h2>Three routes to the same residency.</h2>
          </div>
          <InvestmentDeadlineNote />
          <p class="route-pointer">
            The Qualified Investor Visa has three paths: real estate, listed securities from $500,000, or a $750,000 fixed-term deposit. The current real estate minimum is $300,000; this is scheduled to increase to $500,000 on October 15, 2026. See the <a href="/panama-qualified-investor-visa-2026#investment-routes">full breakdown of all three routes</a>.
          </p>
          <p class="note">
            Processing is 30 to 90 days from document submission to provisional permit. See the <a href="/panama-qualified-investor-visa-process-2026">process</a>.
          </p>
        </div>
      </div>
    </section>

    <FAQSection
      items={faqs}
      eyebrow="Common questions"
      heading="Questions H-1B holders ask most."
      id="page-faq"
      background="cream"
    />
    <ProgramFAQSection background="paper" />
    <section class="cta-band">
      <div class="wrap">
        <div class="cta-inner">
          <h2>Ready to explore your options?</h2>
          <p>15 minutes with an advisor who specializes in immigration backup plans for H-1B holders.</p>
          <button
            class="btn btn--gold"
            type="button"
            data-advisor-contact-open
            aria-haspopup="dialog"
            aria-controls="advisor-contact-modal"
          >
            Speak with an Advisor
          </button>
          <p class="cta-mail">
            Or email us at <a href="mailto:info@panamaqualifiedinvestor.com">info@panamaqualifiedinvestor.com</a>
          </p>
        </div>
      </div>
    </section>
    <TopCTA />
  </main>
  <FaqJsonLd items={faqs} />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: var(--header-h);
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 40%;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(45, 61, 77, 0.96) 16%,
      rgba(45, 61, 77, 0.72) 50%,
      rgba(45, 61, 77, 0.38)
    );
    pointer-events: none;
  }

  .content {
    text-align: center;
    max-width: var(--measure);
    width: 100%;
    margin-inline: auto;
    padding: 4rem clamp(1.35rem, 5vw, 3rem);
    box-sizing: border-box;
  }

  h1 {
    color: var(--color-on-navy);
    margin: 1.1rem 0 0;
    overflow-wrap: break-word;
  }

  .subtext {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-on-navy-dim);
    margin: 1.5rem auto 0;
  }

  .actions {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .paper {
    background: var(--color-paper);
  }

  .narrow {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .sec-head.left {
    text-align: left;
  }

  .sec-head.left h2 {
    margin-top: var(--space-eyebrow);
  }

  .prose p {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: var(--weight-body);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-paragraph);
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .cards {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .card {
    background: var(--color-paper);
    border-radius: 6px;
    border: 1px solid var(--color-line);
    padding: 1.5rem;
    transition: box-shadow 150ms ease-out;
  }

  .card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .card-title {
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    font-size: var(--text-body);
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }

  .card p:last-child {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-ink-soft);
    line-height: var(--leading-body);
  }

  .route-pointer {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--color-ink-soft);
    line-height: var(--leading-body);
    margin: 1.5rem 0 0;
  }

  .note {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-muted);
    margin: 1.5rem 0 0;
    text-align: center;
    line-height: var(--leading-body);
  }

  .cta-band {
    background: linear-gradient(200deg, #4e6478 0%, #405363 55%, #2d3d4d 100%);
    padding-block: var(--section-pad);
    text-align: center;
  }

  .cta-inner {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .cta-band h2 {
    font-family: var(--font-display);
    font-size: var(--text-h2-sm);
    font-weight: 600;
    color: var(--color-on-navy);
    line-height: var(--leading-h3);
  }

  .cta-band p:not(.cta-mail) {
    color: var(--color-on-navy-dim);
    margin: var(--space-lede) 0 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .cta-band .btn {
    margin-top: 1.5rem;
  }

  .cta-mail {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: var(--weight-ui);
    color: rgba(255, 255, 255, 0.72);
    margin-top: 1.25rem;
    letter-spacing: var(--tracking-ui);
  }

  .cta-mail a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
