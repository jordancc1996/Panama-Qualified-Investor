---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import TopCTA from '../components/TopCTA.astro';
import CtaBand from '../components/CtaBand.astro';
import MonthlyUpdates from '../components/MonthlyUpdates.astro';
import FAQSection from '../components/FAQSection.astro';
import ProgramFAQSection from '../components/ProgramFAQSection.astro';
import FaqJsonLd from '../components/FaqJsonLd.astro';

const pageFaqs = [
  {
    q: 'How do I choose which guide to read?',
    a: 'Start with the guide that matches your situation: <a href="/americans">Americans</a>, <a href="/canadians">Canadians</a>, <a href="/tech-founders">tech founders</a>, <a href="/h1b">H-1B holders</a>, or <a href="/crypto-investors">crypto investors</a>. Each page covers tax, process, and investment points that differ by audience. The visa itself is the same program for every nationality.',
  },
  {
    q: 'What if none of the five guides describe my situation?',
    a: 'The Qualified Investor Visa is open to citizens of every country. There are <a href="/panama-qualified-investor-visa-eligibility">no nationality-based quotas</a>. If you do not see your situation in the cards above, <a href="/#book">speak with an advisor</a> and we will help you assess whether the QIV fits.',
  },
];

const audiences = [
  {
    kicker: 'Americans',
    title: 'A tax-efficient Plan B outside the US',
    body: "Whether you're hedging against political uncertainty, diversifying your residency portfolio, or looking for a dollar-denominated base with zero tax on foreign income, Panama's QIV gives you permanent residency without renouncing US citizenship. No FATCA complications on the residency itself, and the territorial tax system means your US-sourced income is only taxed by the IRS, not Panama.",
    cta: 'See how other Americans have qualified',
    href: '/americans',
  },
  {
    kicker: 'Canadians',
    title: 'Residency in a stable, dollarized economy',
    body: "Canada's capital gains changes and rising cost of living are pushing more Canadians to explore residency abroad. Panama's Qualified Investor Visa offers permanent residency with no strict minimum stay requirement (periodic presence is recommended), a territorial tax system that doesn't tax foreign income, and a familiar banking infrastructure. The current real estate minimum is $300,000; this is scheduled to increase to $500,000 on October 15, 2026. That entry point is lower than most European golden visas.",
    cta: 'Talk to an advisor who works with Canadians',
    href: '/canadians',
  },
  {
    kicker: 'Tech founders <span class="amp">&amp;</span> remote CEOs',
    title: 'Build from anywhere, base somewhere strategic',
    body: "If your company is remote-first or you're between rounds, Panama offers legitimate residency in a timezone that overlaps with both US coasts, a territorial tax system ideal for foreign-incorporated entities, and a modern financial hub with direct flights to Miami, New York, and San Francisco. No language test, no cultural exam, and your family can be included.",
    cta: 'Book a founder-focused consultation',
    href: '/tech-founders',
  },
  {
    kicker: 'H-1B visa holders',
    title: "Permanent residency that doesn't depend on your employer",
    body: "The US green card backlog for some nationalities can stretch for many years. Processing is 30 to 90 days from document submission to provisional permit, with no country-specific quotas, no employer sponsorship, and no lottery. It's not a replacement for your US immigration case. It's a parallel path that gives you a permanent legal home while you wait.",
    cta: 'Get a free H-1B backup plan assessment',
    href: '/h1b',
  },
  {
    kicker: 'Crypto investors',
    title: 'Turn digital gains into permanent residency',
    body: "Crypto-derived wealth doesn't fit neatly into most immigration programs — some countries won't touch it, others demand disclosures that make investors walk away. Panama's QIV treats a documented crypto gain the same as any other lawful source of funds: trace it, document it, and it qualifies like cash or securities would. Panama's territorial tax system means foreign-sourced gains aren't taxed locally either way, and your residency isn't tied to any exchange, wallet, or jurisdiction staying stable.",
    cta: 'See how crypto gains qualify as source of funds',
    href: '/crypto-investors',
  },
];

const heroImage = '/images/hero-who-its-for.webp';
const heroWidth = 1024;
const heroHeight = 767;

const title = 'Who is the Panama Qualified Investor Visa for? | Americans, Canadians, Founders, H-1B';
const description =
  'The Panama Qualified Investor Visa serves Americans, Canadians, tech founders, and H-1B holders. Find the guide for your situation. Updated for 2026 investors.';
---

<BaseLayout title={title} description={description} ogDescription={description} path="/who-is-the-panama-qualified-investor-visa-for">
  <Navbar />
  <main id="main">
    <section class="page-hero">
      <img
        class="hero-bg"
        src={heroImage}
        alt="Three children in a wooden dugout canoe on turquoise water, with a palm island behind them"
        width={heroWidth}
        height={heroHeight}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="content">
        <p class="eyebrow eyebrow--on-navy">Who it's for</p>
        <h1>Who is the Panama Qualified Investor Visa for?</h1>
        <p class="subtext">
          The QIV works differently depending on where you're coming from. We've written a detailed guide for each group.
        </p>
      </div>
    </section>
    <MonthlyUpdates />

    <section class="section paper">
      <div class="wrap">
        <div class="grid audience-grid">
          {
            audiences.map((item, i) => (
              <a href={item.href} class="bcard card">
                <p class="kicker" set:html={item.kicker} />
                <h3>{item.title}</h3>
                <p class="body" set:html={item.body} />
                <span class="cta-link cta-link--ink card-link">
                  {item.cta.replace(' →', '')}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section bg-cream-tint">
      <div class="wrap">
        <div class="narrow">
          <div class="sec-head left">
            <p class="eyebrow">Everyone else</p>
            <h2>The QIV is open to all nationalities.</h2>
          </div>
          <div class="prose">
            <p>
              While our detailed guides focus on the groups we work with most, the Panama Qualified Investor Visa is open to citizens of every country. There are <a href="/panama-qualified-investor-visa-eligibility">no nationality-based quotas</a> or restrictions.
            </p>
            <p>
              Whether you're a European investor looking for a base in the Americas, a Middle Eastern entrepreneur seeking dollar-denominated stability, or an Asia-Pacific professional planning for retirement, <a href="/panama-qualified-investor-visa-2026">the same program applies</a>. The investment threshold, processing timeline, and benefits are identical regardless of your passport. If you don't see your situation above, get in touch. We'll help you assess whether the QIV is the right fit.
            </p>
          </div>
        </div>
      </div>
    </section>

    <FAQSection
      items={pageFaqs}
      eyebrow="Common questions"
      heading="Choosing a guide."
      id="page-faq"
      background="paper"
    />
    <ProgramFAQSection background="cream" />
    <CtaBand />
    <TopCTA />
  </main>
  <FaqJsonLd items={pageFaqs} />
</BaseLayout>

<style>
  .page-hero {
    overflow: hidden;
    isolation: isolate;
    background: none;
    min-height: 70vh;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
  }

  .page-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(45, 61, 77, 0.96) 16%,
      rgba(45, 61, 77, 0.72) 50%,
      rgba(45, 61, 77, 0.38)
    );
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 1;
  }

  .narrow {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .sec-head.left {
    text-align: left;
  }

  .grid {
    display: grid;
    gap: 1.5rem;
  }

  .card {
    padding: 1.35rem 1.4rem;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #405363;
    margin: 0;
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    margin: 0.6rem 0 0.5rem;
  }

  .card .body {
    margin: 0;
    font-size: var(--text-body);
    color: var(--color-ink-soft);
    line-height: var(--leading-body);
    font-weight: var(--weight-body);
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .grid > * {
      grid-column: span 2;
    }

    .grid > *:nth-child(4) {
      grid-column: 2 / span 2;
    }

    .grid > *:nth-child(5) {
      grid-column: 4 / span 2;
    }
  }

  a.bcard {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  a.bcard:hover {
    border-color: var(--color-navy-900);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    transform: translateY(-3px);
  }

  a.bcard:hover .kicker {
    color: var(--color-navy-900);
  }

  a.bcard:hover .card-link {
    color: var(--color-navy-900);
    text-decoration: underline;
  }
</style>
